def direction(x):

    if pd.isna(x):
        return "NA"

    if x > 0:
        return "Upregulated"

    if x < 0:
        return "Downregulated"

    return "Neutral"


def build_pair_table(
    taxa,
    association
):

    rows = []

    for taxon in taxa:

        a = deseq_a[
            deseq_a["microbe"] == taxon
        ]

        b = deseq_b[
            deseq_b["microbe"] == taxon
        ]

        if len(a) != 1:
            raise ValueError(
                f"{DISEASE_A}: taxa not uniquely found: {taxon}"
            )

        if len(b) != 1:
            raise ValueError(
                f"{DISEASE_B}: taxa not uniquely found: {taxon}"
            )

        a = a.iloc[0]
        b = b.iloc[0]

        lfc_a = a["log2FoldChange"]
        lfc_b = b["log2FoldChange"]

        padj_a = a["padj"]
        padj_b = b["padj"]

        dir_a = direction(lfc_a)
        dir_b = direction(lfc_b)

        if (
            dir_a in ["Upregulated", "Downregulated"]
            and
            dir_a == dir_b
        ):
            comparison = "Agreement"

        elif (
            dir_a in ["Upregulated", "Downregulated"]
            and
            dir_b in ["Upregulated", "Downregulated"]
            and
            dir_a != dir_b
        ):
            comparison = "Opposite"

        else:
            comparison = "Neutral/NA"

        rows.append({

            "microbe":
                taxon,

            "Association":
                association,

            f"{DISEASE_A}_log2FoldChange":
                lfc_a,

            f"{DISEASE_A}_padj":
                padj_a,

            f"{DISEASE_A}_direction":
                dir_a,

            f"{DISEASE_B}_log2FoldChange":
                lfc_b,

            f"{DISEASE_B}_padj":
                padj_b,

            f"{DISEASE_B}_direction":
                dir_b,

            "Direction_comparison":
                comparison,

            f"{DISEASE_A}_significant":
                bool(
                    pd.notna(padj_a)
                    and
                    padj_a < PADJ_THRESHOLD
                ),

            f"{DISEASE_B}_significant":
                bool(
                    pd.notna(padj_b)
                    and
                    padj_b < PADJ_THRESHOLD
                )
        })

    return pd.DataFrame(rows)


