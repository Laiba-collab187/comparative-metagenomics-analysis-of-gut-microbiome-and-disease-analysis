# ================================================================
# TAXON NORMALIZATION
# ================================================================

def normalize_taxon(x):

    if pd.isna(x):
        return ""

    s = str(x).strip()

    for c in [
        "\ufeff",
        "\u200b",
        "\u200c",
        "\u200d",
        "\u2060"
    ]:
        s = s.replace(c, "")

    s = re.sub(r"\s+", " ", s)

    return s


# ================================================================
# AUTOMATICALLY IDENTIFY TOP-100 FILES
# ================================================================

def find_top100_file(disease, association):

    disease_key = disease.lower().replace("_", "")

    candidates = []

    for root, dirs, filenames in os.walk(INPUT_DIR):

        for filename in filenames:

            if not filename.lower().endswith(".csv"):
                continue

            low = filename.lower().replace("_", "").replace("-", "")

            if disease_key not in low:
                continue

            if "top100" not in low:
                continue

            if association == "case":

                if (
                    "case" in low
                    or "disease" in low
                    or "up" in low
                ):
                    candidates.append(
                        os.path.join(root, filename)
                    )

            elif association == "control":

                if (
                    "control" in low
                    or "healthy" in low
                    or "down" in low
                ):
                    candidates.append(
                        os.path.join(root, filename)
                    )

    if len(candidates) == 0:

        raise FileNotFoundError(
            f"\n{disease}: could not identify corrected "
            f"top-100 {association} file.\n"
            f"Search directory:\n{INPUT_DIR}"
        )

    # Remove duplicate paths
    candidates = sorted(set(candidates))

    if len(candidates) > 1:

        # Prefer the shortest filename/path because this usually
        # corresponds to the primary corrected output.
        candidates = sorted(
            candidates,
            key=lambda x: (len(os.path.basename(x)), x)
        )

    return candidates[0]


# ================================================================
# LOAD AND VERIFY ALL 10 DISEASES
# ================================================================

case_sets = {}
control_sets = {}

