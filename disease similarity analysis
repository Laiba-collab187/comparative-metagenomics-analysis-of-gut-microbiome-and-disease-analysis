# ============================================================
# CREATE LFC MATRICES FOR SHARED MICROBES
# ============================================================

def create_lfc_matrix(
    shared_microbes,
    lfc_tables
):

    microbes = list(
        shared_microbes["microbe"]
    )

    matrix = pd.DataFrame(
        np.nan,
        index=diseases,
        columns=microbes
    )


    for disease in diseases:

        lfc_series = lfc_tables[
            disease
        ]

        for microbe in microbes:

            if microbe in lfc_series.index:

                matrix.loc[
                    disease,
                    microbe
                ] = lfc_series.loc[
                    microbe
                ]


    return matrix


case_lfc_matrix = create_lfc_matrix(
    case_shared,
    lfc_tables
)

control_lfc_matrix = create_lfc_matrix(
    control_shared,
    lfc_tables
)


