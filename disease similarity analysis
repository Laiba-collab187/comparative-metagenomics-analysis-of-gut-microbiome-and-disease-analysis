# ============================================================
# 7. FUNCTION TO IDENTIFY LFC CONFIDENCE-LIMIT COLUMNS
# ============================================================
#
# The reference method uses:
#
# CASE:
# highest 5% LFC confidence limit
#
# CONTROL:
# lowest 95% LFC confidence limit
#
# Depending on your DESeq2 output, these may appear as:
#
# lfcSE
# lfc_5CI
# lfc_95CI
#
# or:
#
# LFC_5CI
# LFC_95CI
#
# or another naming convention.
#
# ============================================================


def find_column(df, possible_names):

    lower_map = {
        str(c).lower().strip(): c
        for c in df.columns
    }

    for name in possible_names:

        if name.lower() in lower_map:
            return lower_map[name.lower()]

    return None


def identify_columns(df):

    # microbial species column
    microbe_col = find_column(
        df,
        [
            "microbe",
            "species",
            "taxon",
            "taxa",
            "name"
        ]
    )

    # LFC
    lfc_col = find_column(
        df,
        [
            "log2FoldChange",
            "log2foldchange",
            "log2FC",
            "LFC"
        ]
    )

    # lower confidence limit
    lfc5_col = find_column(
        df,
        [
            "LFC_5CI",
            "lfc_5ci",
            "LFC_5CI_lower",
            "lfc_5ci_lower",
            "log2FoldChange_5CI"
        ]
    )

    # upper confidence limit
    lfc95_col = find_column(
        df,
        [
            "LFC_95CI",
            "lfc_95ci",
            "LFC_95CI_upper",
            "lfc_95ci_upper",
            "log2FoldChange_95CI"
        ]
    )

    # baseMean
    basemean_col = find_column(
        df,
        [
            "baseMean",
            "basemean"
        ]
    )

    # adjusted p value
    padj_col = find_column(
        df,
        [
            "padj",
            "adjusted_pvalue",
            "adjusted_p_value",
            "FDR"
        ]
    )

    return {
        "microbe": microbe_col,
        "lfc": lfc_col,
        "lfc5": lfc5_col,
        "lfc95": lfc95_col,
        "baseMean": basemean_col,
        "padj": padj_col
    }


