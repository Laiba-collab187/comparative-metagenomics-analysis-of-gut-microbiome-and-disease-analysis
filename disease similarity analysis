REQUIRED_COLUMNS = [
    "microbe",
    "baseMean",
    "log2FoldChange",
    "lfcSE",
    "stat",
    "pvalue",
    "padj"
]


# ================================================================
# STEP 4 — READ AND VALIDATE ALL 10 FILES
# ================================================================

data = {}

print("\n" + "=" * 80)
print("READING AND VALIDATING DESEQ2 RESULTS")
print("=" * 80)

for disease, filepath in FILES.items():

    df = pd.read_csv(filepath)

    print("\n" + disease)
    print("-" * 50)

    print("Rows   :", len(df))
    print("Columns:", list(df.columns))

    missing_columns = [
        col
        for col in REQUIRED_COLUMNS
        if col not in df.columns
    ]

    if missing_columns:

        raise ValueError(
            f"\n{disease} is missing these required columns:\n"
            f"{missing_columns}"
        )

    # Keep only the required DESeq2 columns
    df = df[REQUIRED_COLUMNS].copy()

    # Convert numeric columns safely
    numeric_columns = [
        "baseMean",
        "log2FoldChange",
        "lfcSE",
        "stat",
        "pvalue",
        "padj"
    ]

    for col in numeric_columns:

        df[col] = pd.to_numeric(
            df[col],
            errors="coerce"
        )

    # Clean microbe names
    df["microbe"] = (
        df["microbe"]
        .astype(str)
        .str.strip()
    )

    # Remove blank / invalid microbe names
    df = df[
        df["microbe"].notna()
        &
        (df["microbe"] != "")
        &
        (df["microbe"].str.lower() != "nan")
    ].copy()

    # Remove rows where the values required for CI calculation
    # are unavailable
    df = df[
        df["log2FoldChange"].notna()
        &
        df["lfcSE"].notna()
    ].copy()

    # Remove impossible negative standard errors
    df = df[
        df["lfcSE"] >= 0
    ].copy()

    # Remove duplicated microbial names
    df = (
        df
        .drop_duplicates(
            subset="microbe",
            keep="first"
        )
        .reset_index(drop=True)
    )

    data[disease] = df

    print("Valid rows:", len(df))

    print(
        "Duplicate microbes removed:",
        len(pd.read_csv(filepath))
        - len(
            pd.read_csv(filepath)[["microbe"]]
            .drop_duplicates()
        )
    )


print("\nPASS: All 10 DESeq2 datasets validated.")


# ================================================================
# STEP 5 — CALCULATE THE 5% AND 95% CONFIDENCE LIMITS
# ================================================================
#
# DESeq2 provides:
#
# log2FoldChange
# lfcSE
#
# We calculate:
#
# Lower 5% confidence limit
#     = log2FC - 1.645 × SE
#
# Upper 95% confidence limit
#     = log2FC + 1.645 × SE
#
# These are the directional limits used for ranking.
# ================================================================

Z_VALUE = 1.645

for disease in data:

    df = data[disease].copy()

    df["LFC_5CI"] = (
        df["log2FoldChange"]
        -
        Z_VALUE * df["lfcSE"]
    )

    df["LFC_95CI"] = (
        df["log2FoldChange"]
        +
        Z_VALUE * df["lfcSE"]
    )

    data[disease] = df


print("\n" + "=" * 80)
print("CONFIDENCE LIMITS CALCULATED")
print("=" * 80)

print(
    "Lower 5% limit = log2FoldChange - 1.645 × lfcSE"
)

print(
    "Upper 95% limit = log2FoldChange + 1.645 × lfcSE"
)


# ================================================================
# STEP 6 — CREATE TOP 100 CASE-ASSOCIATED TAXA
# ================================================================
#
# CASE-ASSOCIATED:
# Highest values of the LOWER 5% confidence limit.
#
# ================================================================

TOP_N = 100

TOP_CASE = {}

TOP_CONTROL = {}


for disease, df in data.items():

    case_df = (
        df
        .sort_values(
            by="LFC_5CI",
            ascending=False
        )
        .head(TOP_N)
        .copy()
        .reset_index(drop=True)
    )

    case_df["Case_Rank"] = (
        np.arange(
            1,
            len(case_df) + 1
        )
    )

    TOP_CASE[disease] = case_df


# ================================================================
# STEP 7 — CREATE TOP 100 CONTROL-ASSOCIATED TAXA
# ================================================================
#
# CONTROL-ASSOCIATED:
# Lowest values of the UPPER 95% confidence limit.
#
# ================================================================

for disease, df in data.items():

    control_df = (
        df
        .sort_values(
            by="LFC_95CI",
            ascending=True
        )
        .head(TOP_N)
        .copy()
        .reset_index(drop=True)
    )

    control_df["Control_Rank"] = (
        np.arange(
            1,
            len(control_df) + 1
        )
    )

    TOP_CONTROL[disease] = control_df


