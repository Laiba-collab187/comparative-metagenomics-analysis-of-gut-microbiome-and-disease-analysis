# ============================================================
# DISEASE SIMILARITY ANALYSIS
# ============================================================

import os
import itertools
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


# ============================================================
# INPUT FILES
# ============================================================

disease_files = {
    "Autism": "ASD_DESeq2_full_results.csv",
    "Colorectal neoplasm": "colorectal neoplasm DESeq2_full_results.csv",
    "Dwarfism": "dwarfism_results.csv",
    "Ulcerative colitis": "ulcerative colitis deseq2_results.csv",
    "Fibromyalgia": "fibromyalgia deseq2_results.csv",
    "IBS": "IBS_full_DESeq2_results.csv",
    "Fatigue": "fatigue all_results.csv",
    "Obesity": "obesity_full_DESeq2_results.csv",
    "Neuroblastoma": "Neuroblastoma_full_DESeq2_results.csv",
    "COVID-19": "covid Full_DESeq2_results.csv"
}


# ============================================================
# OUTPUT DIRECTORY
# ============================================================

OUTPUT_DIR = "Disease_Similarity_Results"
os.makedirs(OUTPUT_DIR, exist_ok=True)


# ============================================================
# FUNCTION TO DETECT MICROBIAL SPECIES COLUMN
# ============================================================

def detect_microbe_column(df):

    preferred_columns = [
        "microbe",
        "species",
        "taxon",
        "Unnamed: 0"
    ]

    for column in preferred_columns:
        if column in df.columns:
            return column

    raise ValueError(
        "Microbial species column could not be detected."
    )


# ============================================================
# PREPARE DESEQ2 DATA AND GENERATE TOP 100 MICROBES
# ============================================================

case_tables = {}
control_tables = {}
lfc_tables = {}

validation_rows = []


for disease, file_name in disease_files.items():

    print("\n" + "=" * 80)
    print(disease)
    print("=" * 80)

    df = pd.read_csv(file_name)

    microbe_column = detect_microbe_column(df)

    df = df.rename(
        columns={microbe_column: "microbe"}
    )

    required_columns = [
        "microbe",
        "baseMean",
        "log2FoldChange",
        "lfcSE"
    ]

    missing_columns = [
        column
        for column in required_columns
        if column not in df.columns
    ]

    if missing_columns:
        raise ValueError(
            f"{disease}: missing columns {missing_columns}"
        )

    df = df[
        required_columns
    ].copy()

    df["microbe"] = (
        df["microbe"]
        .astype(str)
        .str.strip()
    )

    df["baseMean"] = pd.to_numeric(
        df["baseMean"],
        errors="coerce"
    )

    df["log2FoldChange"] = pd.to_numeric(
        df["log2FoldChange"],
        errors="coerce"
    )

    df["lfcSE"] = pd.to_numeric(
        df["lfcSE"],
        errors="coerce"
    )

    df = df.dropna(
        subset=[
            "microbe",
            "log2FoldChange",
            "lfcSE"
        ]
    )

    df = df.drop_duplicates(
        subset="microbe"
    )

    df["disease"] = disease


    # --------------------------------------------------------
    # 90% CONFIDENCE LIMITS
    # 5th and 95th percentile limits
    # --------------------------------------------------------

    Z_VALUE = 1.645

    df["LFC_5CI"] = (
        df["log2FoldChange"]
        - Z_VALUE * df["lfcSE"]
    )

    df["LFC_95CI"] = (
        df["log2FoldChange"]
        + Z_VALUE * df["lfcSE"]
    )


    # --------------------------------------------------------
    # CASE-ASSOCIATED MICROBES
    # Ranked using lower confidence limit
    # --------------------------------------------------------

    case_top100 = (
        df
        .sort_values(
            "LFC_5CI",
            ascending=False
        )
        .head(100)
        .copy()
    )

    case_top100["case_rank"] = np.arange(
        1,
        len(case_top100) + 1
    )


    # --------------------------------------------------------
    # CONTROL-ASSOCIATED MICROBES
    # Ranked using upper confidence limit
    # --------------------------------------------------------

    control_top100 = (
        df
        .sort_values(
            "LFC_95CI",
            ascending=True
        )
        .head(100)
        .copy()
    )

    control_top100["control_rank"] = np.arange(
        1,
        len(control_top100) + 1
    )


    # --------------------------------------------------------
    # STORE TABLES
    # --------------------------------------------------------

    case_tables[disease] = case_top100

    control_tables[disease] = control_top100

    lfc_tables[disease] = (
        df
        .set_index("microbe")[
            "log2FoldChange"
        ]
    )


    # --------------------------------------------------------
    # SAVE TOP 100 FILES
    # --------------------------------------------------------

    safe_name = (
        disease
        .replace(" ", "_")
        .replace("-", "_")
    )

    case_top100.to_csv(
        os.path.join(
            OUTPUT_DIR,
            f"{safe_name}_Top100_Case.csv"
        ),
        index=False
    )

    control_top100.to_csv(
        os.path.join(
            OUTPUT_DIR,
            f"{safe_name}_Top100_Control.csv"
        ),
        index=False
    )


    validation_rows.append(
        {
            "Disease": disease,
            "Total_DESeq2_species": len(df),
            "Case_top100": len(case_top100),
            "Control_top100": len(control_top100)
        }
    )

    print(
        "DESeq2 species:",
        len(df)
    )

    print(
        "Case-associated species:",
        len(case_top100)
    )

    print(
        "Control-associated species:",
        len(control_top100)
    )


# ============================================================
# SAVE VALIDATION TABLE
# ============================================================

validation_df = pd.DataFrame(
    validation_rows
)

validation_df.to_csv(
    os.path.join(
        OUTPUT_DIR,
        "Top100_Validation.csv"
    ),
    index=False
)


# ============================================================
# DISEASE PAIR OVERLAP ANALYSIS
# ============================================================

diseases = list(
    disease_files.keys()
)

pair_results = []


for disease_1, disease_2 in itertools.combinations(
    diseases,
    2
):

    case_set_1 = set(
        case_tables[disease_1]["microbe"]
    )

    case_set_2 = set(
        case_tables[disease_2]["microbe"]
    )

    control_set_1 = set(
        control_tables[disease_1]["microbe"]
    )

    control_set_2 = set(
        control_tables[disease_2]["microbe"]
    )


    shared_case = sorted(
        case_set_1.intersection(
            case_set_2
        )
    )

    shared_control = sorted(
        control_set_1.intersection(
            control_set_2
        )
    )


    pair_results.append(
        {
            "Disease_1": disease_1,
            "Disease_2": disease_2,
            "Case_overlap": len(shared_case),
            "Control_overlap": len(shared_control),
            "Total_overlap":
                len(shared_case)
                + len(shared_control),
            "Shared_case_microbes":
                "; ".join(shared_case),
            "Shared_control_microbes":
                "; ".join(shared_control)
        }
    )


pair_df = pd.DataFrame(
    pair_results
)

pair_df = pair_df.sort_values(
    "Total_overlap",
    ascending=False
)

pair_df.to_csv(
    os.path.join(
        OUTPUT_DIR,
        "Final_Top100_Disease_Pair_Overlap.csv"
    ),
    index=False
)


