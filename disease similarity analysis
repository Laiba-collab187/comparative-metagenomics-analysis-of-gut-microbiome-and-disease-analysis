# ============================================================
# 9. STOP IF REQUIRED LFC CONFIDENCE LIMITS ARE MISSING
# ============================================================

for disease, cols in column_map.items():

    required = [
        "microbe",
        "lfc5",
        "lfc95"
    ]

    missing = [
        x
        for x in required
        if cols[x] is None
    ]

    if missing:

        raise ValueError(
            f"\n{disease} is missing required columns: "
            f"{missing}\n"
            "We should NOT guess the ranking method."
        )


# ============================================================
# 10. CREATE DIRECTIONAL TOP-100 SIGNATURES
# ============================================================
#
# IMPORTANT:
#
# NO padj < 0.05 FILTER IS USED HERE.
#
# This is intentional.
#
# The reference method explicitly states that the directional
# ranking is NOT limited to species passing an adjusted
# p-value threshold.
#
# We therefore rank the full DESeq2 result according to the
# LFC confidence limits.
#
# ============================================================


TOP_N = 100

top100_case = {}
top100_control = {}

validation_rows = []


for disease, f in disease_files.items():

    df = pd.read_csv(f)

    cols = column_map[disease]

    microbe_col = cols["microbe"]
    lfc5_col = cols["lfc5"]
    lfc95_col = cols["lfc95"]
    basemean_col = cols["baseMean"]

    work = df.copy()

    # --------------------------------------------------------
    # Rename to standardized names
    # --------------------------------------------------------

    work = work.rename(
        columns={
            microbe_col: "microbe",
            lfc5_col: "LFC_5CI",
            lfc95_col: "LFC_95CI"
        }
    )

    if basemean_col is not None:

        work = work.rename(
            columns={
                basemean_col: "baseMean"
            }
        )

    else:

        work["baseMean"] = np.nan


    # --------------------------------------------------------
    # Convert numerical columns
    # --------------------------------------------------------

    work["LFC_5CI"] = pd.to_numeric(
        work["LFC_5CI"],
        errors="coerce"
    )

    work["LFC_95CI"] = pd.to_numeric(
        work["LFC_95CI"],
        errors="coerce"
    )

    work["baseMean"] = pd.to_numeric(
        work["baseMean"],
        errors="coerce"
    )


    # --------------------------------------------------------
    # Remove missing microbial names
    # --------------------------------------------------------

    work = work[
        work["microbe"].notna()
    ].copy()

    work["microbe"] = (
        work["microbe"]
        .astype(str)
        .str.strip()
    )

    work = work[
        work["microbe"] != ""
    ]


    # --------------------------------------------------------
    # Remove Homo sapiens / host
    # --------------------------------------------------------

    host_mask = (
        work["microbe"]
        .str.lower()
        .str.contains(
            r"homo sapiens|human",
            regex=True,
            na=False
        )
    )

    host_removed = int(
        host_mask.sum()
    )

    work = work[
        ~host_mask
    ].copy()


    # --------------------------------------------------------
    # Remove rows where baseMean = 0
    # --------------------------------------------------------

    zero_mask = (
        work["baseMean"]
        .fillna(0)
        .eq(0)
    )

    zero_removed = int(
        zero_mask.sum()
    )

    work = work[
        ~zero_mask
    ].copy()


    # --------------------------------------------------------
    # Remove rows lacking LFC confidence values
    # --------------------------------------------------------

    work = work[
        work["LFC_5CI"].notna()
        &
        work["LFC_95CI"].notna()
    ].copy()


    # --------------------------------------------------------
    # CASE-ASSOCIATED TOP 100
    #
    # Highest 5% LFC confidence limit
    # --------------------------------------------------------

    case = (
        work
        .sort_values(
            "LFC_5CI",
            ascending=False
        )
        .drop_duplicates(
            subset="microbe"
        )
        .head(TOP_N)
        .copy()
    )

    case["case_rank"] = np.arange(
        1,
        len(case) + 1
    )

    case["disease"] = disease


    # --------------------------------------------------------
    # CONTROL-ASSOCIATED TOP 100
    #
    # Lowest 95% LFC confidence limit
    # --------------------------------------------------------

    control = (
        work
        .sort_values(
            "LFC_95CI",
            ascending=True
        )
        .drop_duplicates(
            subset="microbe"
        )
        .head(TOP_N)
        .copy()
    )

    control["control_rank"] = np.arange(
        1,
        len(control) + 1
    )

    control["disease"] = disease


    # --------------------------------------------------------
    # SAVE
    # --------------------------------------------------------

    top100_case[disease] = case

    top100_control[disease] = control


    # --------------------------------------------------------
    # VALIDATION
    # --------------------------------------------------------

    validation_rows.append({

        "Disease": disease,

        "Original_rows": len(df),

        "Rows_after_cleaning": len(work),

        "Case_Top100_n": len(case),

        "Control_Top100_n": len(control),

        "Host_rows_removed": host_removed,

        "Zero_baseMean_rows_removed": zero_removed,

        "Case_min_LFC_5CI":
            case["LFC_5CI"].min()
            if len(case) else np.nan,

        "Case_max_LFC_5CI":
            case["LFC_5CI"].max()
            if len(case) else np.nan,

        "Control_min_LFC_95CI":
            control["LFC_95CI"].min()
            if len(control) else np.nan,

        "Control_max_LFC_95CI":
            control["LFC_95CI"].max()
            if len(control) else np.nan
    })


# ============================================================
# 11. VALIDATION TABLE
