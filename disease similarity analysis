# ============================================================
# 13. CALCULATE ALL 45 PAIRWISE OVERLAPS
# ============================================================
#
# For each disease pair:
#
# Case overlap =
# intersection of their Top-100 case lists
#
# Control overlap =
# intersection of their Top-100 control lists
#
# Total overlap =
# case overlap + control overlap
#
# ============================================================

diseases = sorted(
    disease_files.keys()
