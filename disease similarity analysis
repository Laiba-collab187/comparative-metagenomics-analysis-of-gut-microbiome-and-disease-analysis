    # Identify columns
    # ------------------------------------------------------------

    cols = {
        str(c).strip().lower(): c
        for c in df.columns
    }

    taxon_col = None
    lfc_col = None
    padj_col = None

    for name in [
        "microbe",
        "species",
        "taxon",
        "taxa",
        "name",
        "feature"
    ]:
        if name in cols:
            taxon_col = cols[name]
            break

    for name in [
        "log2foldchange",
        "lfc"
    ]:
        if name in cols:
            lfc_col = cols[name]
            break

    for name in [
        "padj",
        "adjusted_pvalue",
        "adjusted_p_value",
        "fdr"
    ]:
        if name in cols:
            padj_col = cols[name]
            break

    if taxon_col is None:
        raise ValueError(
            f"{disease}: taxon column not found.\n"
            f"Available columns: {list(df.columns)}"
        )

    if lfc_col is None:
        raise ValueError(
            f"{disease}: log2FoldChange column not found."
        )

    if padj_col is None:
        raise ValueError(
            f"{disease}: padj column not found."
        )

    result = df[
        [
            taxon_col,
            lfc_col,
            padj_col
        ]
    ].copy()

    result.columns = [
        "microbe",
        "log2FoldChange",
        "padj"
    ]

    result["microbe"] = (
        result["microbe"]
        .apply(normalize_taxon)
    )

    result["log2FoldChange"] = pd.to_numeric(
        result["log2FoldChange"],
        errors="coerce"
    )

    result["padj"] = pd.to_numeric(
        result["padj"],
        errors="coerce"
    )

    result = result[
        result["microbe"] != ""
    ].copy()

    if result["microbe"].duplicated().any():

        duplicates = (
            result.loc[
                result["microbe"].duplicated(),
                "microbe"
            ]
            .tolist()
        )

        raise ValueError(
            f"{disease}: duplicate taxa detected.\n"
            f"{duplicates[:20]}"
        )

    return result


