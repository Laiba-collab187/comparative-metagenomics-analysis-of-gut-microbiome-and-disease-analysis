        OUTPUT_DIR,
        "Top100_Control_Overlap_Matrix.csv"
    )
)


# ============================================================
# PLOT OVERLAP HEATMAP FUNCTION
# ============================================================

def plot_overlap_heatmap(
    matrix,
    title,
    output_file
):

    fig, ax = plt.subplots(
        figsize=(12, 10)
    )

    image = ax.imshow(
        matrix.values,
        aspect="auto"
    )

    ax.set_xticks(
        np.arange(
            len(matrix.columns)
        )
    )

    ax.set_yticks(
        np.arange(
            len(matrix.index)
        )
    )

    ax.set_xticklabels(
        matrix.columns,
        rotation=55,
        ha="right"
    )

    ax.set_yticklabels(
        matrix.index
    )

    for i in range(
        len(matrix.index)
    ):

        for j in range(
            len(matrix.columns)
        ):

            ax.text(
                j,
                i,
                int(
                    matrix.iloc[i, j]
                ),
                ha="center",
                va="center"
            )

    ax.set_title(
        title
    )

    fig.colorbar(
        image,
        ax=ax
    )

    plt.tight_layout()

    plt.savefig(
        output_file,
        dpi=300,
        bbox_inches="tight"
    )

    plt.close()


plot_overlap_heatmap(
    case_overlap_matrix,
    "Overlap of top 100 case-associated microbial species",
    os.path.join(
        OUTPUT_DIR,
        "Case_Associated_Overlap.png"
    )
)

plot_overlap_heatmap(
    control_overlap_matrix,
    "Overlap of top 100 control-associated microbial species",
    os.path.join(
        OUTPUT_DIR,
        "Control_Associated_Overlap.png"
    )
)


# ============================================================
# MICROBES SHARED BY MORE THAN TWO DISEASES
# ============================================================

def identify_shared_microbes(
    ranked_tables,
    rank_column
):

    microbial_diseases = {}

    for disease, table in ranked_tables.items():

        for microbe in table["microbe"]:

            microbial_diseases.setdefault(
                microbe,
                []
            )

            microbial_diseases[
                microbe
            ].append(
                disease
            )


    rows = []

    for microbe, disease_list in microbial_diseases.items():

        if len(disease_list) > 2:

            rows.append(
                {
                    "microbe": microbe,
                    "number_of_diseases":
                        len(disease_list),
                    "diseases":
                        "; ".join(
                            sorted(
                                disease_list
                            )
                        )
                }
            )


    shared_df = pd.DataFrame(
        rows
    )

    shared_df = shared_df.sort_values(
        [
            "number_of_diseases",
            "microbe"
        ],
        ascending=[
            False,
            True
        ]
    )

    return shared_df


case_shared = identify_shared_microbes(
    case_tables,
    "case_rank"
)

control_shared = identify_shared_microbes(
    control_tables,
    "control_rank"
)


case_shared.to_csv(
