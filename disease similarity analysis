def load_deseq2(disease):

    path = os.path.join(
        DESEQ_DIR,
        f"{disease}_CORRECTED_full_DESeq2_results.csv"
    )

    if not os.path.exists(path):

        raise FileNotFoundError(
            f"Corrected DESeq2 file missing:\n{path}"
        )

    df = pd.read_csv(path)

    columns_lower = {
        str(c).strip().lower(): c
        for c in df.columns
    }

    taxon_col = None
    lfc_col = None
    padj_col = None

    for x in [
        "microbe",
        "species",
        "taxon",
        "taxa",
        "name",
        "feature"
    ]:

        if x in columns_lower:
            taxon_col = columns_lower[x]
            break

    for x in [
        "log2foldchange",
        "log2foldchange",
        "lfc"
    ]:

        if x in columns_lower:
            lfc_col = columns_lower[x]
            break

    for x in [
        "padj",
        "adjusted_pvalue",
        "adjusted_p_value",
        "fdr"
    ]:

        if x in columns_lower:
            padj_col = columns_lower[x]
            break

    if taxon_col is None:
        raise ValueError(
            f"{disease}: DESeq2 taxon column not found."
        )

    if lfc_col is None:
        raise ValueError(
            f"{disease}: DESeq2 log2FoldChange column not found."
        )

    if padj_col is None:
        raise ValueError(
            f"{disease}: DESeq2 padj column not found."
        )

    result = df[
        [
            taxon_col,
            lfc_col,
            padj_col
        ]
    ].copy()

    result.columns = [
        "microbe",
        "log2FoldChange",
        "padj"
    ]

    result["microbe"] = (
        result["microbe"]
        .apply(normalize_taxon)
    )

    result["log2FoldChange"] = pd.to_numeric(
        result["log2FoldChange"],
        errors="coerce"
    )

    result["padj"] = pd.to_numeric(
        result["padj"],
        errors="coerce"
    )

    if result["microbe"].duplicated().any():

        raise ValueError(
            f"{disease}: duplicate taxa detected "
            f"in corrected DESeq2."
        )

    return result


