# ================================================================
# FUNCTION TO EXTRACT DESeq2 INFORMATION
# ================================================================

def extract_pair_table(
    taxa,
    set_type
):

    rows = []

    for taxon in taxa:

        row_a = deseq_a[
            deseq_a["microbe"] == taxon
        ]

        row_b = deseq_b[
            deseq_b["microbe"] == taxon
        ]

        if len(row_a) != 1:
            raise ValueError(
                f"{DISEASE_A}: taxa not uniquely found: "
                f"{taxon}"
            )

        if len(row_b) != 1:
            raise ValueError(
                f"{DISEASE_B}: taxa not uniquely found: "
                f"{taxon}"
            )

        a = row_a.iloc[0]
        b = row_b.iloc[0]

        lfc_a = a["log2FoldChange"]
        lfc_b = b["log2FoldChange"]

        padj_a = a["padj"]
        padj_b = b["padj"]

        # --------------------------------------------------------
        # Direction
        # --------------------------------------------------------

        if lfc_a > 0:
            direction_a = "Upregulated"
        elif lfc_a < 0:
            direction_a = "Downregulated"
        else:
            direction_a = "Neutral"

        if lfc_b > 0:
            direction_b = "Upregulated"
        elif lfc_b < 0:
            direction_b = "Downregulated"
        else:
            direction_b = "Neutral"

        # --------------------------------------------------------
        # Direction comparison
        # --------------------------------------------------------

        if (
            direction_a == direction_b
            and direction_a != "Neutral"
        ):

            agreement = "Agreement"

        elif (
            direction_a != direction_b
            and direction_a != "Neutral"
            and direction_b != "Neutral"
        ):

            agreement = "Opposite"

        else:

            agreement = "Neutral"

        rows.append({

            "microbe": taxon,

            "Set": set_type,

            f"{DISEASE_A}_log2FoldChange":
                lfc_a,

            f"{DISEASE_A}_padj":
                padj_a,

            f"{DISEASE_A}_direction":
                direction_a,

            f"{DISEASE_B}_log2FoldChange":
                lfc_b,

            f"{DISEASE_B}_padj":
                padj_b,

            f"{DISEASE_B}_direction":
                direction_b,

            "Direction_comparison":
                agreement,

            f"{DISEASE_A}_significant":
                bool(
                    pd.notna(padj_a)
