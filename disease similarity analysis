    )

    case_set_2 = set(
        top100_case[disease_2]["microbe"]
    )

    control_set_1 = set(
        top100_control[disease_1]["microbe"]
    )

    control_set_2 = set(
        top100_control[disease_2]["microbe"]
    )


    shared_case = (
        case_set_1
        &
        case_set_2
    )

    shared_control = (
        control_set_1
        &
        control_set_2
    )


    case_overlap = len(
        shared_case
    )

    control_overlap = len(
        shared_control
    )

    total_overlap = (
        case_overlap
        +
        control_overlap
    )


    pair_results.append({

        "Disease_1":
            disease_1,

        "Disease_2":
            disease_2,

        "Case_overlap":
            case_overlap,

        "Control_overlap":
            control_overlap,

        "Total_overlap":
            total_overlap
    })


# ============================================================
