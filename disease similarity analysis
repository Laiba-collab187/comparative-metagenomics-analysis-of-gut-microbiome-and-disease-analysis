# 14. CREATE DISEASE × SPECIES LFC MATRIX
# ================================================================

def create_lfc_matrix(
    all_signature_data,
    recurrent_species,
    disease_order
):

    subset = all_signature_data[
        all_signature_data["Species"].isin(
            recurrent_species.index
        )
    ].copy()

    matrix = subset.pivot(
        index="Disease",
        columns="Species",
        values="log2FoldChange"
    )

    # Force exact disease order
    matrix = matrix.reindex(
        disease_order
    )

    # Sort columns by recurrence first,
    # then alphabetically for reproducibility.
    recurrence_order = (
        recurrent_species
        .sort_values(
            ascending=False
        )
        .index
    )

    matrix = matrix.reindex(
        columns=recurrence_order
    )

    return matrix


