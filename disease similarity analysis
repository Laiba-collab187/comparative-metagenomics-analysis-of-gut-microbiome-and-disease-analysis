# ================================================================
# 5. ROBUST COLUMN DETECTION
# ================================================================

def find_column(df, candidates):

    normalized = {
        re.sub(
            r"[^a-z0-9]",
            "",
            str(c).lower()
        ): c
        for c in df.columns
    }

    # Exact normalized match
    for candidate in candidates:

        key = re.sub(
            r"[^a-z0-9]",
            "",
            candidate.lower()
        )

        if key in normalized:
            return normalized[key]

    # Partial match
    for col in df.columns:

        normalized_col = re.sub(
            r"[^a-z0-9]",
            "",
            str(col).lower()
        )

        for candidate in candidates:

            key = re.sub(
                r"[^a-z0-9]",
                "",
                candidate.lower()
            )

            if key in normalized_col:
                return col

    return None


# ================================================================
# 6. TAXON NORMALIZATION
# ================================================================

def normalize_taxon(value):

    if pd.isna(value):
        return ""

    x = str(value).strip()

    # Remove invisible characters
    for char in [
        "\ufeff",
        "\u200b",
        "\u200c",
        "\u200d",
        "\u2060",
        "\xa0"
    ]:
        x = x.replace(char, " ")

    # Collapse repeated whitespace
    x = re.sub(
        r"\s+",
        " ",
        x
    ).strip()

    return x


# ================================================================
# 7. READ ONE TOP-100 FILE
# ================================================================

def read_top100(
    path,
    expected_category,
    disease
):

    df = pd.read_csv(path)

    # ------------------------------------------------------------
    # Detect taxon/species column
    # ------------------------------------------------------------

    taxon_col = find_column(
        df,
        [
            "microbe",
            "microbial_species",
            "species",
            "taxon",
            "taxa",
            "name",
            "feature"
        ]
    )

    if taxon_col is None:

        raise ValueError(
            f"\n{path.name}: Could not identify microbial "
            f"taxon column.\n"
            f"Available columns:\n{list(df.columns)}"
        )

    # ------------------------------------------------------------
    # Detect LFC column
    # ------------------------------------------------------------

    lfc_col = find_column(
        df,
        [
            "log2FoldChange",
            "log2 fold change",
            "log2fc",
            "lfc"
        ]
    )

    if lfc_col is None:

        raise ValueError(
            f"\n{path.name}: Could not identify "
            f"log2FoldChange column.\n"
            f"Available columns:\n{list(df.columns)}"
        )

    # ------------------------------------------------------------
    # Standardize
    # ------------------------------------------------------------

    result = pd.DataFrame({

        "Disease": disease,

        "Species": (
            df[taxon_col]
            .apply(normalize_taxon)
        ),

        "log2FoldChange": pd.to_numeric(
            df[lfc_col],
            errors="coerce"
        )
    })

    # ------------------------------------------------------------
    # Remove empty taxa only
    # ------------------------------------------------------------

    result = result[
        result["Species"] != ""
    ].copy()

    # ------------------------------------------------------------
    # LFC must be numeric
    # ------------------------------------------------------------

    if result["log2FoldChange"].isna().any():

        bad = result[
            result["log2FoldChange"].isna()
        ]["Species"].tolist()

        raise ValueError(
            f"\n{path.name}: "
            f"Non-numeric LFC values found for:\n"
            f"{bad[:10]}"
        )

    # ------------------------------------------------------------
    # EXACTLY 100 FEATURES
    # ------------------------------------------------------------

    if len(result) != 100:

        raise ValueError(
            f"\n{path.name}: expected exactly 100 taxa, "
            f"found {len(result)}."
        )

    # ------------------------------------------------------------
    # NO DUPLICATE TAXA
    # ------------------------------------------------------------

    if result["Species"].duplicated().any():

        duplicates = (
            result.loc[
                result["Species"].duplicated(),
                "Species"
            ]
            .tolist()
        )

        raise ValueError(
            f"\n{path.name}: duplicate taxa detected:\n"
            f"{duplicates[:20]}"
        )

    # ------------------------------------------------------------
    # REMOVE Homo sapiens if accidentally present
    # BUT DO NOT SILENTLY REMOVE IT:
    # this is a QC failure because corrected inputs should
    # already contain no Homo sapiens.
    # ------------------------------------------------------------

    human = result[
        result["Species"].str.lower()
        == "homo sapiens"
    ]

    if len(human) > 0:

        raise ValueError(
            f"\n{path.name}: Homo sapiens detected.\n"
            f"The corrected Top-100 input should already "
            f"be Homo sapiens-free."
        )

    # ------------------------------------------------------------
    # VERIFY DIRECTION
    # ------------------------------------------------------------

    if expected_category == "disease":

        wrong_direction = result[
            result["log2FoldChange"] <= 0
        ]

        if len(wrong_direction) > 0:

            raise ValueError(
                f"\n{path.name}: "
                f"{len(wrong_direction)} disease-enriched "
                f"taxa have non-positive log2FC.\n"
                f"This indicates an unexpected Top-100 input."
            )

    elif expected_category == "healthy":

        wrong_direction = result[
            result["log2FoldChange"] >= 0
        ]

        if len(wrong_direction) > 0:

            raise ValueError(
                f"\n{path.name}: "
                f"{len(wrong_direction)} healthy-enriched "
                f"taxa have non-negative log2FC.\n"
                f"This indicates an unexpected Top-100 input."
            )

    return result


