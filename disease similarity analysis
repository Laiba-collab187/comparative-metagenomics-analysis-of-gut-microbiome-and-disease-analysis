# shared Top-100 case-associated microbes
#
# Control overlap:
# shared Top-100 control-associated microbes
#
# Total overlap:
# case overlap + control overlap
#
# ================================================================

diseases = list(FILES.keys())

pair_results = []


for disease_1, disease_2 in itertools.combinations(
