    "IBS",
    "Neuroblastoma",
    "Obesity",
    "Ulcerative_Colitis"
]

TOP_N = 100


# ================================================================
# LOAD DESeq2
# ================================================================

def load_deseq2(disease):

    path = os.path.join(
        DESEQ_DIR,
        f"{disease}_CORRECTED_full_DESeq2_results.csv"
    )

    if not os.path.exists(path):

        raise FileNotFoundError(
            f"{disease}: missing corrected DESeq2 file:\n{path}"
        )

    df = pd.read_csv(path)

    required = [
        "microbe",
        "log2FoldChange",
        "padj"
    ]

    missing = [
        c for c in required
        if c not in df.columns
    ]

    if missing:

        raise ValueError(
            f"{disease}: missing required columns: {missing}"
        )

    df = df[
        required
    ].copy()

    df["microbe"] = (
        df["microbe"]
        .astype(str)
        .str.strip()
    )

    df["log2FoldChange"] = pd.to_numeric(
        df["log2FoldChange"],
        errors="coerce"
    )

    df["padj"] = pd.to_numeric(
        df["padj"],
        errors="coerce"
    )

    # Remove invalid taxon names
    df = df[
        df["microbe"].notna()
        &
        (df["microbe"] != "")
    ].copy()

    # Remove duplicate taxa
    if df["microbe"].duplicated().any():

        dup = (
            df.loc[
                df["microbe"].duplicated(),
                "microbe"
            ]
            .tolist()
        )

        raise ValueError(
            f"{disease}: duplicate taxa detected:\n{dup[:10]}"
        )

    return df


# ================================================================
# PROCESS ALL 10 DISEASES
# ================================================================

summary_rows = []

for disease in DISEASES:

    print("\n" + "=" * 100)
    print(disease.upper())
    print("=" * 100)

    df = load_deseq2(disease)

    # ------------------------------------------------------------
    # REMOVE NON-INFORMATIVE RESULTS
    # ------------------------------------------------------------

    valid = df[
        df["log2FoldChange"].notna()
        &
        np.isfinite(df["log2FoldChange"])
        &
        (df["log2FoldChange"] != 0)
    ].copy()

    # ------------------------------------------------------------
    # DISEASE-ENRICHED
    # ------------------------------------------------------------

    disease_enriched = valid[
        valid["log2FoldChange"] > 0
    ].copy()

    # Strongest positive effect first
    disease_enriched = (
        disease_enriched
        .sort_values(
            [
                "log2FoldChange",
                "padj"
            ],
            ascending=[
                False,
                True
            ],
            na_position="last"
        )
        .head(TOP_N)
        .reset_index(drop=True)
    )

    disease_enriched.insert(
        0,
        "Rank",
        range(
            1,
            len(disease_enriched) + 1
        )
    )

    disease_enriched["Disease"] = disease
    disease_enriched["Association"] = "Disease-enriched"

    # ------------------------------------------------------------
    # HEALTHY-ENRICHED
    # ------------------------------------------------------------

    healthy_enriched = valid[
        valid["log2FoldChange"] < 0
    ].copy()

    # Most negative effect first
    healthy_enriched = (
        healthy_enriched
        .sort_values(
            [
                "log2FoldChange",
                "padj"
            ],
            ascending=[
                True,
                True
            ],
            na_position="last"
        )
        .head(TOP_N)
        .reset_index(drop=True)
    )

    healthy_enriched.insert(
        0,
        "Rank",
        range(
            1,
            len(healthy_enriched) + 1
        )
    )

    healthy_enriched["Disease"] = disease
    healthy_enriched["Association"] = "Healthy-enriched"

    # ------------------------------------------------------------
    # SAVE
    # ------------------------------------------------------------

    disease_file = os.path.join(
        OUTDIR,
        f"{disease}_TOP100_DISEASE_ENRICHED_CORRECTED.csv"
    )

    healthy_file = os.path.join(
        OUTDIR,
        f"{disease}_TOP100_HEALTHY_ENRICHED_CORRECTED.csv"
    )

    disease_enriched.to_csv(
        disease_file,
        index=False
    )

    healthy_enriched.to_csv(
        healthy_file,
        index=False
    )

    # ------------------------------------------------------------
    # QC
    # ------------------------------------------------------------

    print(
        "Total DESeq2 taxa:",
        len(df)
    )

    print(
        "Non-zero log2FC taxa:",
        len(valid)
    )

    print(
        "Disease-enriched available:",
        len(disease_enriched)
    )

    print(
        "Healthy-enriched available:",
        len(healthy_enriched)
    )

    if len(disease_enriched) < TOP_N:

        print(
            "WARNING: fewer than 100 disease-enriched taxa."
        )

    if len(healthy_enriched) < TOP_N:

        print(
            "WARNING: fewer than 100 healthy-enriched taxa."
        )

    summary_rows.append({

        "Disease":
            disease,

        "Total_DESeq2_taxa":
            len(df),

        "Nonzero_log2FC_taxa":
            len(valid),

        "Disease_enriched_available":
            len(disease_enriched),

        "Healthy_enriched_available":
            len(healthy_enriched),

        "Disease_enriched_significant":
            int(
                (
                    disease_enriched["padj"]
                    < 0.05
                ).sum()
            ),

        "Healthy_enriched_significant":
            int(
                (
                    healthy_enriched["padj"]
                    < 0.05
                ).sum()
            )
    })


