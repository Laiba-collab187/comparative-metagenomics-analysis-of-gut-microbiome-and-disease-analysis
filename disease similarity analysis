    # FIND MICROBE COLUMN
    # ------------------------------------------------------------

    def get_microbe_column(df):

        exact = {
            str(c).strip().lower(): c
            for c in df.columns
        }

        for name in [
            "microbe",
            "species",
            "taxon",
            "taxa",
            "name"
        ]:

