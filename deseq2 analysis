master_all = []
master_sig = []

for disease in DISEASES:

    print("\n" + "=" * 100)
    print(disease.upper())
    print("=" * 100)

    ddir = os.path.join(
        SHAP_DIR,
        disease
    )

    shap_file = [
        f for f in os.listdir(ddir)
        if "SHAP" in f.upper()
        and "SUMMARY" in f.upper()
        and f.lower().endswith(".csv")
    ][0]

    shap = pd.read_csv(
        os.path.join(
            ddir,
            shap_file
        )
    )

    # ------------------------------------------------------------
    # IDENTIFY SHAP COLUMNS
    # ------------------------------------------------------------

    microbe_col = find_column(
        shap,
        ["microbe", "species", "taxon", "taxa"]
    )

    rank_col = find_column(
        shap,
        ["rank", "shap_rank"]
    )

    shap_value_col = find_column(
        shap,
        [
            "mean_abs_shap",
            "mean_abs_SHAP",
            "mean absolute shap",
            "mean_abs"
        ]
    )

    if microbe_col is None:
        raise ValueError(
            f"{disease}: SHAP microbe column not found.\n"
            f"Columns: {list(shap.columns)}"
        )

    if rank_col is None:
        raise ValueError(
            f"{disease}: SHAP rank column not found."
        )

    if shap_value_col is None:
        raise ValueError(
            f"{disease}: SHAP importance column not found."
        )

    # ------------------------------------------------------------
    # LOCK TOP 30 SHAP FEATURES
    # ------------------------------------------------------------

    shap = shap[
        [
            microbe_col,
            rank_col,
            shap_value_col
        ]
    ].copy()

    shap.columns = [
        "microbe",
        "SHAP_rank",
        "Mean_abs_SHAP"
    ]

    shap["microbe"] = (
        shap["microbe"]
        .apply(normalize_taxon)
    )

    shap["SHAP_rank"] = pd.to_numeric(
        shap["SHAP_rank"],
        errors="coerce"
    )

    shap["Mean_abs_SHAP"] = pd.to_numeric(
        shap["Mean_abs_SHAP"],
        errors="coerce"
    )

    shap = (
        shap
        .sort_values("SHAP_rank")
        .head(30)
        .copy()
    )

    if len(shap) != 30:
        raise ValueError(
            f"{disease}: expected 30 SHAP features; "
            f"found {len(shap)}."
        )

    # ------------------------------------------------------------
    # READ CORRECTED DESeq2
    # ------------------------------------------------------------

    deseq = pd.read_csv(
        os.path.join(
            DESEQ_DIR,
            f"{disease}_CORRECTED_full_DESeq2_results.csv"
        )
    )

    taxon_col = find_column(
        deseq,
        [
            "microbe",
            "species",
            "taxon",
            "taxa",
            "feature",
            "name"
        ]
    )

    lfc_col = find_column(
        deseq,
        [
            "log2FoldChange",
            "log2foldchange",
            "lfc"
        ]
    )

    padj_col = find_column(
        deseq,
        [
            "padj",
            "adjusted_pvalue",
            "adjusted_p_value",
            "fdr"
        ]
    )

    if taxon_col is None:
        raise ValueError(
            f"{disease}: DESeq2 taxon column not found."
        )

    if lfc_col is None:
        raise ValueError(
            f"{disease}: DESeq2 log2FoldChange missing."
        )

    if padj_col is None:
        raise ValueError(
            f"{disease}: DESeq2 padj missing."
        )

    deseq = deseq[
        [
            taxon_col,
            lfc_col,
            padj_col
        ]
    ].copy()

    deseq.columns = [
        "DESeq2_microbe",
        "DESeq2_log2FoldChange",
        "DESeq2_padj"
    ]

    deseq["_match"] = (
        deseq["DESeq2_microbe"]
        .apply(normalize_taxon)
    )

    if deseq["_match"].duplicated().any():
        raise ValueError(
            f"{disease}: duplicate taxa in corrected DESeq2."
        )

    # ------------------------------------------------------------
    # MERGE
    # ------------------------------------------------------------

    shap["_match"] = (
        shap["microbe"]
        .apply(normalize_taxon)
    )

    merged = pd.merge(
        shap,
        deseq[
            [
                "_match",
                "DESeq2_microbe",
                "DESeq2_log2FoldChange",
                "DESeq2_padj"
            ]
        ],
        on="_match",
        how="left",
        validate="one_to_one"
    )

    matched = (
        merged["DESeq2_log2FoldChange"]
        .notna()
    )

    if not matched.all():

        unmatched = merged.loc[
            ~matched,
            "microbe"
        ].tolist()

        raise ValueError(
            f"{disease}: SHAP taxa not found in corrected DESeq2:\n"
            + "\n".join(unmatched)
        )

    # ------------------------------------------------------------
    # SIGNIFICANCE
    # ------------------------------------------------------------

    merged["DESeq2_significant"] = (
        merged["DESeq2_padj"] < PADJ_THRESHOLD
    )

    # ------------------------------------------------------------
    # DIRECTIONS
    # ------------------------------------------------------------

    merged["DESeq2_direction"] = np.where(
        merged["DESeq2_log2FoldChange"] > 0,
        "Upregulated",
        np.where(
            merged["DESeq2_log2FoldChange"] < 0,
            "Downregulated",
            "Zero"
        )
    )

    # SHAP direction is based on the sign of the SHAP contribution
    # represented in the existing SHAP summary/integration workflow.
