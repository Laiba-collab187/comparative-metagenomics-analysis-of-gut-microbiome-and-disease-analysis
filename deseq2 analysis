)

cat("\n")
cat("============================================================\n")
cat("ALL 10 CORRECTED DESeq2 ANALYSES COMPLETED\n")
cat("============================================================\n")

print(
    summary_df,
    row.names=FALSE
)

cat("\nOutput folder:\n")
cat(out_dir, "\n")
'''

script_path = "/content/run_corrected_deseq2_FINAL.R"

with open(script_path, "w") as f:
