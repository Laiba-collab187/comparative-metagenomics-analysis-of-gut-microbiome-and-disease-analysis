        raise ValueError(
            f"{disease}: log2FoldChange missing."
        )

    if se_col is None:
        raise ValueError(
            f"{disease}: lfcSE missing."
        )

    work = df[
        [
            taxon_col,
            lfc_col,
            se_col
        ]
    ].copy()

    work.columns = [
        "microbe",
        "log2FoldChange",
        "lfcSE"
    ]

    work["microbe"] = (
        work["microbe"]
        .apply(clean_taxon)
    )

    work["log2FoldChange"] = pd.to_numeric(
        work["log2FoldChange"],
        errors="coerce"
    )

    work["lfcSE"] = pd.to_numeric(
        work["lfcSE"],
        errors="coerce"
    )

    work = work[
        (work["microbe"] != "")
        &
        work["log2FoldChange"].notna()
        &
        work["lfcSE"].notna()
    ].copy()

    if work["microbe"].duplicated().any():

        raise ValueError(
            f"{disease}: duplicate taxa detected."
        )

    # ------------------------------------------------------------
    # 95% CONFIDENCE INTERVAL
    # ------------------------------------------------------------

    work["CI_lower_95"] = (
        work["log2FoldChange"]
        -
        1.96 * work["lfcSE"]
    )

    work["CI_upper_95"] = (
        work["log2FoldChange"]
        +
        1.96 * work["lfcSE"]
    )

    # ------------------------------------------------------------
    # CASE-ASSOCIATED
    #
    # Highest lower confidence bounds
    # ------------------------------------------------------------

    case = (
        work
        .sort_values(
            [
                "CI_lower_95",
                "log2FoldChange"
            ],
            ascending=[False, False]
        )
        .head(TOP_N)
        .copy()
    )

    case.insert(
        0,
        "Case_rank",
        range(1, len(case) + 1)
    )

    case["Disease"] = disease
    case["Association"] = "Case-associated"

    # ------------------------------------------------------------
    # CONTROL-ASSOCIATED
    #
    # Lowest upper confidence bounds
    # ------------------------------------------------------------

    control = (
        work
        .sort_values(
            [
                "CI_upper_95",
                "log2FoldChange"
            ],
            ascending=[True, True]
        )
        .head(TOP_N)
        .copy()
    )

    control.insert(
        0,
        "Control_rank",
        range(1, len(control) + 1)
    )

    control["Disease"] = disease
    control["Association"] = "Control-associated"

    # ------------------------------------------------------------
    # VALIDATION
    # ------------------------------------------------------------

    if len(case) != 100:
        raise ValueError(
            f"{disease}: case set has {len(case)} taxa."
        )

    if len(control) != 100:
        raise ValueError(
            f"{disease}: control set has {len(control)} taxa."
        )

    # ------------------------------------------------------------
    # SAVE
    # ------------------------------------------------------------

    case.to_csv(
        os.path.join(
            OUTDIR,
            f"{disease}_TOP100_CASE_ASSOCIATED_CORRECTED.csv"
        ),
        index=False
    )

    control.to_csv(
        os.path.join(
            OUTDIR,
            f"{disease}_TOP100_CONTROL_ASSOCIATED_CORRECTED.csv"
        ),
        index=False
    )

    case_tables[disease] = case
    control_tables[disease] = control

    case_sets[disease] = set(
        case["microbe"]
    )

    control_sets[disease] = set(
        control["microbe"]
    )

    print(
        "DESeq2 taxa:",
        len(work)
    )

    print(
        "Case top-100:",
        len(case_sets[disease])
    )

    print(
        "Control top-100:",
