    )

    # ------------------------------------------------------------
    # SIGNIFICANT OVERLAP
    # ------------------------------------------------------------

    significant = merged[
        merged["DESeq2_significant"]
    ].copy()

    sig_file = os.path.join(
        OUTDIR,
        f"{disease}_CORRECTED_SHAP_DESEQ2_SIGNIFICANT.csv"
    )

