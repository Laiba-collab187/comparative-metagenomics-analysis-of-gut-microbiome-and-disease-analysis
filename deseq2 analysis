def clean_label(x):

    if pd.isna(x):
        return np.nan

    s = str(x)

    # Remove all whitespace, including unusual Unicode spaces
    s = re.sub(r"\s+", "", s)

    # Remove zero-width characters
    for c in [
        "\ufeff",
        "\u200b",
        "\u200c",
        "\u200d",
        "\u2060"
    ]:
        s = s.replace(c, "")

    if s in ["0", "0.0"]:
        return 0

    if s in ["1", "1.0"]:
        return 1

    try:
        v = float(s)

        if v == 0:
            return 0

        if v == 1:
            return 1

    except:
        pass

    return np.nan


