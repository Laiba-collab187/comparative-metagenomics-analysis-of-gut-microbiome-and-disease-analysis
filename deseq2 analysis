def clean_taxon(x):

    if pd.isna(x):
        return ""

    x = str(x).strip()

    for c in [
        "\ufeff",
        "\u200b",
        "\u200c",
        "\u200d",
        "\u2060"
    ]:
        x = x.replace(c, "")

    x = re.sub(r"\s+", " ", x)

    return x


def find_column(df, candidates):

    exact = {
        str(c).strip().lower(): c
        for c in df.columns
    }

    for candidate in candidates:

        if candidate.lower() in exact:
            return exact[candidate.lower()]

    for c in df.columns:

        name = str(c).strip().lower()

        for candidate in candidates:

            if candidate.lower() in name:
                return c

    return None


