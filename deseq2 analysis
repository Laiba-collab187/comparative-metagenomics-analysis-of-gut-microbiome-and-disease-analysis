    )

    metadata = pd.read_excel(
        metadata_file,
        dtype=object
    )

    # ------------------------------------------------------------
    # BASIC CHECKS
    # ------------------------------------------------------------

    if "name" not in abundance.columns:
        raise ValueError(
            f"{disease}: abundance matrix has no 'name' column."
        )

    if "run id" not in metadata.columns:
        raise ValueError(
            f"{disease}: metadata has no 'run id' column."
        )

    if "label" not in metadata.columns:
        raise ValueError(
            f"{disease}: metadata has no 'label' column."
        )

    # ------------------------------------------------------------
    # CLEAN SAMPLE IDs
    # ------------------------------------------------------------

    abundance["name"] = (
        abundance["name"]
        .astype(str)
        .str.strip()
    )

    metadata["run id"] = (
        metadata["run id"]
        .astype(str)
        .str.strip()
    )

    metadata["label"] = (
        metadata["label"]
        .apply(clean_label)
    )

    # ------------------------------------------------------------
    # SAMPLE COUNT
    # ------------------------------------------------------------

    if len(abundance) != 20:
        raise ValueError(
            f"{disease}: abundance has {len(abundance)} samples; "
            f"expected 20."
        )

    if len(metadata) != 20:
        raise ValueError(
            f"{disease}: metadata has {len(metadata)} samples; "
            f"expected 20."
        )

    # ------------------------------------------------------------
    # LABEL CHECK
    # ------------------------------------------------------------

    if metadata["label"].isna().any():

        raise ValueError(
            f"{disease}: invalid/missing labels:\n"
            f"{metadata['label'].tolist()}"
        )

    metadata["label"] = (
        metadata["label"]
        .astype(int)
    )

    if set(metadata["label"]) != {0, 1}:

        raise ValueError(
            f"{disease}: labels are not exactly 0 and 1."
        )

    healthy_n = int(
        (metadata["label"] == 0).sum()
    )

    disease_n = int(
        (metadata["label"] == 1).sum()
    )

    if healthy_n != 10 or disease_n != 10:

        raise ValueError(
            f"{disease}: expected 10 healthy + 10 disease; "
            f"found {healthy_n} healthy + {disease_n} disease."
        )

    # ------------------------------------------------------------
    # SAMPLE ID MATCH
    # ------------------------------------------------------------

    abundance_ids = set(
        abundance["name"]
    )

    metadata_ids = set(
        metadata["run id"]
    )

    if abundance_ids != metadata_ids:

        missing_in_abundance = (
            metadata_ids - abundance_ids
        )

        missing_in_metadata = (
            abundance_ids - metadata_ids
        )

        raise ValueError(
            f"{disease}: sample IDs do not match.\n"
            f"Missing in abundance: {missing_in_abundance}\n"
            f"Missing in metadata: {missing_in_metadata}"
        )

    # ------------------------------------------------------------
    # HOMO SAPIENS CHECK
    # ------------------------------------------------------------

    abundance_taxa = [
        str(c).strip()
        for c in abundance.columns
        if c != "name"
    ]

    human_matches = [
        x for x in abundance_taxa
        if x.lower() == "homo sapiens"
    ]

    if human_matches:

        raise ValueError(
            f"{disease}: Homo sapiens is STILL PRESENT."
        )

    # ------------------------------------------------------------
    # ZERO TAXA CHECK
    # ------------------------------------------------------------

    numeric = abundance[
        abundance_taxa
    ].apply(
        pd.to_numeric,
        errors="coerce"
    )

    zero_taxa = [
        c for c in numeric.columns
        if numeric[c].fillna(0).sum() == 0
    ]

    # Corrected matrices should already have these removed.
    if zero_taxa:

        raise ValueError(
            f"{disease}: completely-zero taxa remain:\n"
            f"{zero_taxa[:20]}"
        )

    # ------------------------------------------------------------
    # STORE
    # ------------------------------------------------------------

    validated[disease] = {
        "abundance": abundance_file,
        "metadata": metadata_file,
        "samples": 20,
        "healthy": healthy_n,
        "disease": disease_n,
        "taxa": len(abundance_taxa)
    }

    print(
        f"{disease:25s} | "
        f"samples=20 | "
        f"healthy={healthy_n} | "
        f"disease={disease_n} | "
        f"microbial_taxa={len(abundance_taxa)} | "
        f"Homo_sapiens=ABSENT | VERIFIED"
    )


