            )
        )
    }

    # -----------------------------------------------------------
    # REORDER ABUNDANCE TO METADATA ORDER
    # -----------------------------------------------------------

    row_order <- match(
        metadata_sample_ids,
        abundance_sample_ids
    )

    raw <- raw[
        row_order,
        ,
        drop=FALSE
    ]

    # -----------------------------------------------------------
    # HOMO SAPIENS CHECK
    # -----------------------------------------------------------

    if (
        any(
            tolower(
                trimws(
                    colnames(raw)
                )
            ) == "homo sapiens"
        )
    ) {
        stop(
            paste(
                disease,
                ": Homo sapiens is still present."
            )
        )
    }

    # -----------------------------------------------------------
    # TAXA
    # -----------------------------------------------------------

    taxa <- trimws(
        colnames(raw)
    )

    if (any(taxa == ""))
        stop(
            paste(
                disease,
                ": blank taxon name detected."
            )
        )

    if (anyDuplicated(taxa))
        stop(
            paste(
                disease,
                ": duplicate taxa detected."
            )
        )

    # -----------------------------------------------------------
    # NUMERIC COUNTS
    # -----------------------------------------------------------

    raw[] <- lapply(
        raw,
        function(x) as.numeric(
            as.character(x)
        )
    )

    if (any(is.na(as.matrix(raw))))
        stop(
            paste(
                disease,
                ": NA values in count matrix."
            )
        )

    if (any(as.matrix(raw) < 0))
        stop(
            paste(
                disease,
                ": negative counts."
            )
        )

    mat <- as.matrix(raw)

    if (
        any(
            abs(mat - round(mat)) > 1e-8
        )
    ) {
        stop(
            paste(
                disease,
                ": non-integer counts detected."
            )
        )
    }

    mat <- round(mat)

    # -----------------------------------------------------------
    # TRANSPOSE
    #
    # Corrected abundance:
    #   rows    = samples
    #   columns = taxa
    #
    # DESeq2:
    #   rows    = taxa
    #   columns = samples
    # -----------------------------------------------------------

    count_matrix <- t(mat)

    rownames(count_matrix) <- taxa
    colnames(count_matrix) <- metadata_sample_ids

    # -----------------------------------------------------------
    # REMOVE ZERO-SUM TAXA
    # -----------------------------------------------------------

    keep <- rowSums(count_matrix) > 0

    count_matrix <- count_matrix[
        keep,
        ,
        drop=FALSE
    ]

    # -----------------------------------------------------------
    # FINAL CHECK
    # -----------------------------------------------------------

    if (ncol(count_matrix) != 20)
        stop(
            paste(
                disease,
                ": final matrix does not contain 20 samples."
            )
        )

    if (!setequal(
        colnames(count_matrix),
        metadata_sample_ids
    ))
        stop(
            paste(
                disease,
                ": final matrix sample IDs mismatch."
            )
        )

    if (
        sum(metadata$label == 0) != 10 ||
        sum(metadata$label == 1) != 10
    ) {
        stop(
            paste(
                disease,
                ": expected 10 Healthy + 10 Disease."
            )
        )
    }

    # -----------------------------------------------------------
    # DESeq2 METADATA
    # -----------------------------------------------------------

    col_data <- data.frame(
        condition=factor(
            ifelse(
                metadata$label == 1,
                "Disease",
                "Healthy"
            ),
            levels=c(
                "Healthy",
                "Disease"
            )
        ),
        row.names=metadata_sample_ids
    )

    # -----------------------------------------------------------
    # RUN DESeq2
    # -----------------------------------------------------------

    dds <- DESeqDataSetFromMatrix(
        countData=count_matrix,
        colData=col_data,
        design=~ condition
    )

    dds <- DESeq(
        dds,
        quiet=TRUE
    )

    res <- results(
        dds,
        contrast=c(
            "condition",
            "Disease",
            "Healthy"
        ),
        alpha=0.05
    )

    # -----------------------------------------------------------
    # RESULTS
    # -----------------------------------------------------------

    result_df <- as.data.frame(res)

    result_df$microbe <- rownames(
        result_df
    )

    result_df <- result_df[
        ,
        c(
            "microbe",
            "baseMean",
            "log2FoldChange",
            "lfcSE",
            "stat",
            "pvalue",
            "padj"
        )
    ]

    result_df <- result_df[
        order(
            result_df$padj,
            na.last=TRUE
        ),
        ,
        drop=FALSE
    ]

    output_file <- file.path(
        out_dir,
        paste0(
            disease,
            "_CORRECTED_full_DESeq2_results.csv"
        )
    )

    write.csv(
        result_df,
        output_file,
        row.names=FALSE
    )

    # -----------------------------------------------------------
    # SUMMARY
    # -----------------------------------------------------------

    sig <- (
        !is.na(result_df$padj)
        &
        result_df$padj < 0.05
    )

    up <- (
        sig
        &
        result_df$log2FoldChange > 0
    )

    down <- (
        sig
        &
        result_df$log2FoldChange < 0
    )

    summary_list[[disease]] <- data.frame(
        Disease=disease,
        Samples=20,
        Healthy=10,
        Disease_samples=10,
        Taxa_tested=nrow(result_df),
        Significant_padj_lt_0_05=sum(sig),
        Upregulated=sum(up),
        Downregulated=sum(down)
    )

    cat(
        "Samples: 20 | ",
        "Taxa: ", nrow(result_df),
        " | Significant: ", sum(sig),
        " | Up: ", sum(up),
        " | Down: ", sum(down),
        "\n",
        sep=""
    )

    cat(
        "SAVED: ",
        output_file,
        "\n",
        sep=""
    )
}

# ================================================================
# MASTER QC
# ================================================================

summary_df <- do.call(
