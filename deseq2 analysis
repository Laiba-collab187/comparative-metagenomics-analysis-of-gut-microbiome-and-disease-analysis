clean_sample_id <- function(x) {

    x <- as.character(x)

    # Normal ASCII whitespace
    x <- gsub("[[:space:]]", "", x)

    # Explicit Unicode whitespace found in your metadata
    x <- gsub("\u00A0", "", x, fixed=TRUE)  # non-breaking space
    x <- gsub("\u2009", "", x, fixed=TRUE)  # thin space
    x <- gsub("\u200A", "", x, fixed=TRUE)  # hair space

    # Zero-width characters
    x <- gsub("\u200B", "", x, fixed=TRUE)
    x <- gsub("\u200C", "", x, fixed=TRUE)
    x <- gsub("\u200D", "", x, fixed=TRUE)
    x <- gsub("\u2060", "", x, fixed=TRUE)
    x <- gsub("\uFEFF", "", x, fixed=TRUE)

    trimws(x)
}


clean_label <- function(x) {

    x <- clean_sample_id(x)

    out <- rep(NA_integer_, length(x))

    out[x %in% c("0", "0.0")] <- 0L
    out[x %in% c("1", "1.0")] <- 1L

    return(out)
}


summary_list <- list()

