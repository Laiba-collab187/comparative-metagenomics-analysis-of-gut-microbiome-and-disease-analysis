# ================================================================
# HELPERS
# ================================================================

def normalize_taxon(x):

    if pd.isna(x):
        return ""

    s = str(x).strip()

    for c in [
        "\ufeff",
        "\u200b",
        "\u200c",
        "\u200d",
        "\u2060"
    ]:
        s = s.replace(c, "")

    s = re.sub(r"\s+", " ", s)

    return s


def find_column(df, candidates):

    exact = {
        str(c).strip().lower(): c
        for c in df.columns
    }

    for x in candidates:
        if x.lower() in exact:
            return exact[x.lower()]

    for c in df.columns:
        name = str(c).strip().lower()

        for x in candidates:
            if x.lower() in name:
                return c

    return None


