DISEASES = [
    "Autism",
    "Colorectal_Neoplasm",
    "COVID19",
    "Dwarfism",
    "Neuroblastoma",
    "Obesity"
]

PADJ_THRESHOLD = 0.05

all_results = []

for disease in DISEASES:

    print("\n" + "=" * 90)
    print(disease)
    print("=" * 90)

    input_file = os.path.join(
        INPUT_DIR,
        f"{disease}_SHAP_DESeq2_INTEGRATED_30_FEATURES.csv"
    )

    if not os.path.exists(input_file):
        raise FileNotFoundError(
            f"{disease}: missing integration file:\n{input_file}"
        )

    df = pd.read_csv(input_file)

    required = [
        "Disease",
        "microbe",
        "SHAP_rank",
        "Mean_abs_SHAP",
        "SHAP_disease_minus_healthy",
        "DESeq2_log2FoldChange",
        "DESeq2_padj"
    ]

    missing = [
        c for c in required
        if c not in df.columns
    ]

    if missing:
        raise ValueError(
            f"{disease}: missing columns: {missing}"
        )

    # ------------------------------------------------------------
    # DESeq2 significance
    # ------------------------------------------------------------

    df["DESeq2_significant"] = (
        pd.to_numeric(
            df["DESeq2_padj"],
            errors="coerce"
        ) < PADJ_THRESHOLD
    )

    # ------------------------------------------------------------
    # Direction according to DESeq2
    # ------------------------------------------------------------

    df["DESeq2_direction"] = np.where(
        df["DESeq2_log2FoldChange"] > 0,
        "Upregulated",
        np.where(
            df["DESeq2_log2FoldChange"] < 0,
            "Downregulated",
            "Zero"
        )
    )

    # ------------------------------------------------------------
    # SHAP-selected + DESeq2-significant intersection
    # ------------------------------------------------------------

    overlap = df[
        df["DESeq2_significant"]
    ].copy()

    # ------------------------------------------------------------
    # Sort by SHAP importance
    # ------------------------------------------------------------

    overlap = (
        overlap
        .sort_values(
            "SHAP_rank"
        )
        .reset_index(drop=True)
    )

    # ------------------------------------------------------------
    # Save disease-specific overlap
    # ------------------------------------------------------------

    outfile = os.path.join(
        OUTDIR,
        f"{disease}_SHAP_DESeq2_SIGNIFICANT_OVERLAP.csv"
    )

    overlap.to_csv(
        outfile,
        index=False
    )

    # ------------------------------------------------------------
    # Summary
    # ------------------------------------------------------------

    up = (
        overlap[
            "DESeq2_direction"
        ] == "Upregulated"
    ).sum()

    down = (
        overlap[
            "DESeq2_direction"
        ] == "Downregulated"
    ).sum()

    print(
        "SHAP-selected taxa:",
        len(df)
    )

    print(
        "DESeq2-significant within SHAP set:",
        len(overlap)
    )

    print(
        "Upregulated:",
        up
    )

    print(
        "Downregulated:",
        down
    )

    print("\nSignificant SHAP-DESeq2 overlap:")

    if len(overlap) > 0:

        print(
            overlap[
                [
                    "SHAP_rank",
                    "microbe",
                    "Mean_abs_SHAP",
                    "SHAP_disease_minus_healthy",
                    "DESeq2_log2FoldChange",
                    "DESeq2_padj",
                    "DESeq2_direction",
                    "Direction_agreement"
                ]
            ].to_string(index=False)
        )

    else:

        print("NONE")

    all_results.append(
        overlap
    )


