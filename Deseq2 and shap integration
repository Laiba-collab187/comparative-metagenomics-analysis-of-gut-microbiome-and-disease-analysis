            f"\n{disease}: DESeq2 file not found:\n{path}\n\n"
            f"Files currently matching {disease} in /content:\n"
            + "\n".join(
                [
                    f for f in os.listdir("/content")
                    if disease.lower() in f.lower()
                    and "deseq" in f.lower()
                ]
            )
        )

    DESEQ_FILES[disease] = path


# ================================================================
# REQUIRED SHAP FILES
# ================================================================

print("=" * 100)
print("VERIFYING ALL INPUT FILES")
print("=" * 100)

for disease in DISEASES:

    required = [

        os.path.join(
            SHAP_DIR,
            disease,
            "RF_SHAP_SUMMARY.csv"
        ),

        os.path.join(
            SHAP_DIR,
            disease,
            "RF_SHAP_TEST_MATRIX.csv"
        ),

        os.path.join(
            SHAP_DIR,
            disease,
            "RF_SHAP_HOLDOUT_SAMPLES.csv"
        ),

        DESEQ_FILES[disease]
    ]

    for path in required:

        if not os.path.exists(path):

