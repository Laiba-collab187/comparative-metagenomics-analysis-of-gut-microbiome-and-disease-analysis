import os
import re
import numpy as np
import pandas as pd

# ================================================================
# PATHS
# ================================================================

SHAP_DIR = "/content/FINAL_REFERENCE_ALIGNED_RF_SHAP"

# YOUR DESeq2 FIXED FILES ARE DIRECTLY IN /content
DESEQ_DIR = "/content"

OUTDIR = "/content/FINAL_SHAP_DESEQ2_INTEGRATION"

os.makedirs(OUTDIR, exist_ok=True)


# ================================================================
# LOCKED 6 DISEASES
# ================================================================

DISEASES = [
    "Autism",
    "Colorectal_Neoplasm",
    "COVID19",
    "Dwarfism",
    "Neuroblastoma",
    "Obesity"
]


# ================================================================
# AUTOMATIC DESeq2 FILE DISCOVERY
# ================================================================

DESEQ_FILES = {}

for disease in DISEASES:

    filename = (
        f"{disease}_FIXED_full_DESeq2_results.csv"
    )

    path = os.path.join(
        DESEQ_DIR,
        filename
    )

    if not os.path.exists(path):
