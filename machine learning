    if "label" not in metadata.columns:
        raise ValueError(
            f"{disease}: label column missing."
        )


    abundance["name"] = (
        abundance["name"]
        .astype(str)
        .str.strip()
    )

    metadata["run id"] = (
        metadata["run id"]
        .astype(str)
        .str.strip()
    )

    metadata["label"] = (
        metadata["label"]
        .apply(clean_binary_label)
    )


    if metadata["label"].isna().any():

        raise ValueError(
            f"{disease}: invalid metadata labels."
        )

    metadata["label"] = (
        metadata["label"]
        .astype(int)
    )


    # ============================================================
    # EXACT 20 + 10/10 VALIDATION
    # ============================================================

    if len(abundance) != 20:
        raise ValueError(
            f"{disease}: abundance does not contain 20 samples."
        )

    if len(metadata) != 20:
        raise ValueError(
            f"{disease}: metadata does not contain 20 samples."
        )

    if (
        (metadata["label"] == 0).sum()
        != 10
    ):
        raise ValueError(
            f"{disease}: Healthy count is not 10."
        )

    if (
        (metadata["label"] == 1).sum()
        != 10
    ):
        raise ValueError(
            f"{disease}: Disease count is not 10."
        )


    # ============================================================
    # HOST MUST NOT BE PRESENT
    # ============================================================

    if "Homo sapiens" in abundance.columns:

        raise ValueError(
            f"{disease}: Homo sapiens is still present."
        )


    # ============================================================
    # EXACT SAMPLE MATCH
    # ============================================================

    if (
        set(abundance["name"])
        !=
        set(metadata["run id"])
    ):

        raise ValueError(
            f"{disease}: abundance and metadata "
            "sample IDs do not match."
        )


    # ============================================================
    # ALIGN
    # ============================================================

    abundance = (
        abundance
        .set_index("name")
        .loc[
            metadata["run id"]
        ]
    )

    species = [
        c
        for c in abundance.columns
    ]


    X = abundance[species].apply(
        pd.to_numeric,
        errors="coerce"
    )

    if X.isna().any().any():

        raise ValueError(
            f"{disease}: non-numeric abundance values."
        )


    y = (
        metadata["label"]
        .reset_index(drop=True)
    )


    # ============================================================
    # SAME HOLD-OUT SPLIT USED IN FINAL ML
    # ============================================================

    X_train, X_test, y_train, y_test = (
        train_test_split(

            X,

            y,

            test_size=0.20,

            stratify=y,

            random_state=42
        )
    )


    if len(X_train) != 16:
        raise ValueError(
            f"{disease}: training cohort is not 16."
        )

    if len(X_test) != 4:
        raise ValueError(
            f"{disease}: hold-out cohort is not 4."
        )


    # ============================================================
    # TRAINING-ONLY FEATURE SELECTION
    # ============================================================

    selector = SelectKBest(
        score_func=f_classif,
        k=30
    )

    X_train_selected = (
        selector.fit_transform(
            X_train,
            y_train
        )
    )

    X_test_selected = (
        selector.transform(
            X_test
        )
    )


    selected_features = (
        X.columns[
            selector.get_support()
        ]
        .tolist()
    )


    if len(selected_features) != 30:

        raise ValueError(
            f"{disease}: expected 30 selected features."
        )


    # ============================================================
    # FINAL RF
    # ============================================================

    rf = RandomForestClassifier(
        random_state=42
    )


    rf.fit(
        X_train_selected,
        y_train
    )


    # ============================================================
    # SHAP TREE EXPLAINER
    # ============================================================

    explainer = shap.TreeExplainer(
        rf
    )


    shap_values_raw = explainer.shap_values(
        X_test_selected
    )


    # ------------------------------------------------------------
    # Handle SHAP output format across SHAP versions
    # ------------------------------------------------------------

    if isinstance(
        shap_values_raw,
        list
    ):

        if len(shap_values_raw) != 2:

            raise ValueError(
                f"{disease}: unexpected SHAP list length."
            )

        shap_values = np.asarray(
            shap_values_raw[1]
        )

    else:

        shap_values = np.asarray(
            shap_values_raw
        )

        # Newer SHAP versions may return:
        # samples × features × classes

        if shap_values.ndim == 3:

            if shap_values.shape[2] != 2:

                raise ValueError(
                    f"{disease}: unexpected SHAP class dimension."
                )

            shap_values = (
                shap_values[:, :, 1]
            )


    # ============================================================
    # SHAPE VALIDATION
    # ============================================================

    if shap_values.shape != (
        X_test_selected.shape[0],
        X_test_selected.shape[1]
    ):

        raise ValueError(
            f"{disease}: SHAP shape mismatch.\n"
            f"SHAP: {shap_values.shape}\n"
            f"Expected: {X_test_selected.shape}"
        )


    # ============================================================
    # SHAP ADDITIVITY CHECK
    # ============================================================
    #
    # For TreeExplainer, check probability-space reconstruction
    # when SHAP provides probability output.
    #
    # We also retain the raw SHAP values used for ranking.
    # ============================================================

    shap_probability_error = None

    try:

        explainer_probability = shap.TreeExplainer(
            rf,
            model_output="probability"
        )

        prob_shap_raw = (
            explainer_probability.shap_values(
                X_test_selected
            )
        )

        if isinstance(
            prob_shap_raw,
            list
        ):

            prob_shap = np.asarray(
                prob_shap_raw[1]
            )

        else:

            prob_shap = np.asarray(
                prob_shap_raw
            )

            if prob_shap.ndim == 3:

                prob_shap = (
                    prob_shap[:, :, 1]
                )


        expected_probability = (
            explainer_probability.expected_value
        )

        if isinstance(
            expected_probability,
            (list, np.ndarray)
        ):

            expected_probability = np.asarray(
                expected_probability
            ).flatten()[-1]

        reconstructed_probability = (
            expected_probability
            +
            prob_shap.sum(axis=1)
        )

        model_probability = (
            rf.predict_proba(
                X_test_selected
            )[:, 1]
        )

        shap_probability_error = float(
            np.max(
                np.abs(
                    reconstructed_probability
                    -
                    model_probability
                )
            )
        )

    except Exception as e:

        print(
            f"{disease}: probability-space "
            f"SHAP check unavailable: {e}"
        )


    # ============================================================
    # MEAN ABSOLUTE SHAP
    # ============================================================

    mean_abs_shap = (
        np.mean(
