def clean_label(x):

    if pd.isna(x):
        return None

    s = str(x)

    s = "".join(
        c for c in s
        if not c.isspace()
    )

    for c in [
        "\ufeff",
        "\u200b",
        "\u200c",
        "\u200d",
        "\u2060"
    ]:
        s = s.replace(c, "")

    if s == "0":
        return 0

    if s == "1":
        return 1

    try:
        v = float(s)

        if v == 0:
            return 0

        if v == 1:
            return 1

    except:
        pass

    return None


