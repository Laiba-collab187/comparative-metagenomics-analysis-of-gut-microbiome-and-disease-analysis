#Train Both Models
from sklearn.ensemble import RandomForestClassifier
from sklearn.ensemble import GradientBoostingClassifier

rf = RandomForestClassifier(
    random_state=42
)

gb = GradientBoostingClassifier(
    random_state=42
)

rf.fit(
    X_train_selected,
    y_train
)

gb.fit(
    X_train_selected,
    y_train
)

#Test Set Prediction
rf_probs = rf.predict_proba(
    X_test_selected
)[:,1]

gb_probs = gb.predict_proba(
    X_test_selected
)[:,1]

#Test AUC
from sklearn.metrics import roc_auc_score

rf_auc = roc_auc_score(
    y_test,
    rf_probs
)

gb_auc = roc_auc_score(
    y_test,
    gb_probs
)

print("Random Forest Test AUC :", rf_auc)
print("Gradient Boosting Test AUC :", gb_auc)

#5-fold Cross Validation
from sklearn.model_selection import StratifiedKFold
from sklearn.model_selection import cross_val_score
from sklearn.pipeline import Pipeline

cv = StratifiedKFold(
    n_splits=5,
    shuffle=True,
    random_state=42
)

rf_pipeline = Pipeline([
    ("selector", SelectKBest(f_classif, k=30)),
    ("rf", RandomForestClassifier(random_state=42))
    ])

gb_pipeline = Pipeline([
    ("selector", SelectKBest(f_classif, k=30)),
    ("gb", GradientBoostingClassifier(random_state=42))
])

rf_scores = cross_val_score(
    rf_pipeline,
    X,
    y,
    cv=cv,
    scoring="roc_auc"
)

gb_scores = cross_val_score(
    gb_pipeline,
    X,
    y,
    cv=cv,
    scoring="roc_auc"
)

print("RF CV AUC :", rf_scores.mean())
print("GB CV AUC :", gb_scores.mean())

#ROC Comparison Figure
from sklearn.metrics import roc_curve, auc
import matplotlib.pyplot as plt

rf_fpr, rf_tpr, _ = roc_curve(y_test, rf_probs)
gb_fpr, gb_tpr, _ = roc_curve(y_test, gb_probs)

rf_auc_plot = auc(rf_fpr, rf_tpr)
gb_auc_plot = auc(gb_fpr, gb_tpr)

plt.figure(figsize=(7,6))

plt.plot(rf_fpr, rf_tpr,
         linewidth=2,
         label=f"Random Forest (AUC = {rf_auc_plot:.2f})")

plt.plot(gb_fpr, gb_tpr,
         linewidth=2,
         label=f"Gradient Boosting (AUC = {gb_auc_plot:.2f})")

plt.plot([0,1],[0,1],'k--')

plt.xlabel("False Positive Rate")
plt.ylabel("True Positive Rate")
plt.title("Colorectal Neoplasm ROC Curve")
plt.legend(loc="lower right")

plt.savefig(
    "Colorectal_Neoplasm_ROC_Comparison.png",
    dpi=600,
    bbox_inches="tight"
)

plt.show()

