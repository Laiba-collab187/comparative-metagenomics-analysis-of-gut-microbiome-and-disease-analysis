#load files
import pandas as pd
import numpy as np

abundance = pd.read_csv(
    "Colorectal_Neoplasm_transpose.tabular",
    sep="\t"
)

labels = pd.read_excel(
    "Colorectal_Neoplasm_metadata.xlsx"
)
#verify the files
print("Abundance shape:", abundance.shape)
print("Labels shape:", labels.shape)

print("\nAbundance columns:")
print(abundance.columns[:5])

print("\nLabels columns:")
print(labels.columns)
#clean run ids
abundance["name"] = (
    abundance["name"]
    .astype(str)
    .str.replace(r"\s+", "", regex=True)
)

labels["run id"] = (
    labels["run id"]
    .astype(str)
    .str.replace(r"\s+", "", regex=True)
)

#merge
merged = abundance.merge(
    labels,
    left_on="name",
    right_on="run id",
    how="inner"
)

print("Merged shape:", merged.shape)
#create x and y
# Feature matrix
X = merged.drop(columns=["name", "run id", "label"])

# Labels
y = merged["label"]

# Clean labels (prevents hidden-space issue)
y = y.astype(str).str.strip().astype(int)

print("X shape:", X.shape)
print("y shape:", y.shape)

print("\nClass counts:")
print(y.value_counts())

#train/test split
from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("Training:", X_train.shape)
print("Testing :", X_test.shape)

#feature selection
from sklearn.feature_selection import SelectKBest, f_classif
ra
selector = SelectKBest(
    score_func=f_classif,
    k=30
)

X_train_selected = selector.fit_transform(
    X_train,
    y_train
)

X_test_selected = selector.transform(
    X_test
)

selected_features = X.columns[
    selector.get_support()
]

print("Selected Features Shape:")
print(X_train_selected.shape)

print("\nSelected Features:")
print(selected_features.tolist())

#Save Selected Features (Output 1)
selected_df = pd.DataFrame({
    "Selected_Microbe": selected_features
})

selected_df.to_excel(
    "Colorectal_Neoplasm_Selected_Features.xlsx",
    index=False
)
