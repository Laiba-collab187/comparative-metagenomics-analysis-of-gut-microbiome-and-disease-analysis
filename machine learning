def clean_binary_label(value):

    if pd.isna(value):
        return None

    text = str(value)

    text = "".join(
        ch for ch in text
        if not ch.isspace()
    )

    for char in [
        "\ufeff",
        "\u200b",
        "\u200c",
        "\u200d",
        "\u2060"
    ]:
        text = text.replace(char, "")

    if text == "0":
        return 0

    if text == "1":
        return 1

    try:

        number = float(text)

        if number == 0:
            return 0

        if number == 1:
            return 1

    except:
        pass

    return None


