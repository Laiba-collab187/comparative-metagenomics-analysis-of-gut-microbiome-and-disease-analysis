# 4. LABEL CLEANING
# ================================================================

def clean_binary_label(value):

    if pd.isna(value):
        return None

    text = str(value)

    # Remove ordinary + Unicode whitespace
    text = "".join(
        ch for ch in text
        if not ch.isspace()
    )

    # Remove invisible Unicode characters
    for char in [
        "\ufeff",
        "\u200b",
        "\u200c",
        "\u200d",
        "\u2060"
    ]:
        text = text.replace(char, "")

    if text == "0":
        return 0

    if text == "1":
        return 1

    try:
        number = float(text)

        if number == 0:
            return 0

        if number == 1:
            return 1

    except:
        pass

    return None


