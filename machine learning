# ================================================================
# REFERENCE-ALIGNED ML QUALIFICATION — CORRECTED RESULTS
# ================================================================
#
# PURPOSE:
# Apply the reference article's AUC > 0.6 criterion to the
# corrected classifier results.
#
# IMPORTANT:
#   CV_AUC is used for the qualification criterion because it
#   represents repeated training/validation performance.
#
#   Test_AUC is the independent 20% HOLD-OUT cohort and is kept
#   separately as validation evidence.
#
#   We DO NOT use Test_AUC to create an additional arbitrary
#   qualification threshold.
#
#   We DO NOT select RF or GB yet.
#
# ================================================================

import os
import numpy as np
import pandas as pd


# ================================================================
# 1. INPUT
# ================================================================

INPUT_FILE = (
    "/content/"
    "CORRECTED_REFERENCE_ALIGNED_ML_PERFORMANCE/"
    "CORRECTED_ALL_DISEASES_RF_GB_PERFORMANCE.csv"
)

OUTDIR = (
    "/content/"
    "CORRECTED_REFERENCE_ALIGNED_ML_PERFORMANCE"
)

os.makedirs(OUTDIR, exist_ok=True)


# ================================================================
# 2. LOAD
# ================================================================

if not os.path.exists(INPUT_FILE):

    raise FileNotFoundError(
        f"Corrected ML performance file not found:\n"
        f"{INPUT_FILE}"
    )

df = pd.read_csv(INPUT_FILE)


required_columns = [
    "Disease",
    "Model",
    "Test_AUC",
    "CV_AUC",
    "Test_Accuracy"
]

missing = [
    c for c in required_columns
    if c not in df.columns
]

if missing:

    raise ValueError(
        f"Missing required columns:\n{missing}"
    )


# ================================================================
# 3. BASIC VALIDATION
# ================================================================

if len(df) != 20:

    raise ValueError(
        f"Expected 20 rows = 10 diseases × 2 models. "
        f"Found {len(df)}."
    )

if df["Disease"].nunique() != 10:

    raise ValueError(
        "Expected exactly 10 diseases."
    )

if df["Model"].nunique() != 2:

    raise ValueError(
        "Expected exactly two classifiers."
    )

expected_models = {
    "Random Forest",
    "Gradient Boosting"
}

if set(df["Model"]) != expected_models:

    raise ValueError(
        f"Unexpected models found: {set(df['Model'])}"
    )


# ================================================================
# 4. REFERENCE ARTICLE QUALIFICATION
# ================================================================
#
# Reference criterion:
#
#       AUC > 0.6
#
# We apply this to CV_AUC.
#
# IMPORTANT:
# AUC exactly 0.600 does NOT qualify because the criterion is > 0.6.
#
# ================================================================

THRESHOLD = 0.60

df["CV_AUC_Qualified"] = (
    df["CV_AUC"] > THRESHOLD
)


# ================================================================
# 5. HOLD-OUT PERFORMANCE IS KEPT SEPARATELY
# ================================================================
#
# We do NOT invent a second threshold.
#
# Instead, we label whether the hold-out AUC is:
#
#   > 0.5  = better than chance
#   = 0.5  = chance
#   < 0.5  = below chance
#
# This is descriptive validation only.
# ================================================================

df["Holdout_AUC_Interpretation"] = np.select(

    [
        df["Test_AUC"] > 0.5,
        np.isclose(
            df["Test_AUC"],
            0.5
        ),
        df["Test_AUC"] < 0.5
    ],

    [
        "Above chance",
        "Chance",
        "Below chance"
    ],

    default="Unknown"
)


# ================================================================
# 6. DISEASE × MODEL TABLE
# ================================================================

disease_model_file = os.path.join(
    OUTDIR,
    "REFERENCE_ALIGNED_CORRECTED_MODEL_QUALIFICATION.csv"
)

df.to_csv(
    disease_model_file,
    index=False
)


# ================================================================
# 7. DISEASE-LEVEL QUALIFICATION
# ================================================================
#
# A disease qualifies for downstream analysis if AT LEAST ONE
# classifier achieves CV AUC > 0.6.
#
# This follows the reference-style disease filtering logic without
# forcing a classifier choice prematurely.
# ================================================================

disease_summary = (
    df
    .groupby("Disease")
    .agg(
        RF_CV_AUC=(
            "CV_AUC",
            lambda x: x[
                df.loc[
                    x.index,
                    "Model"
                ] == "Random Forest"
            ].iloc[0]
        ),

        GB_CV_AUC=(
            "CV_AUC",
            lambda x: x[
                df.loc[
                    x.index,
                    "Model"
                ] == "Gradient Boosting"
            ].iloc[0]
        ),

        RF_Test_AUC=(
            "Test_AUC",
            lambda x: x[
                df.loc[
                    x.index,
                    "Model"
                ] == "Random Forest"
            ].iloc[0]
        ),

        GB_Test_AUC=(
            "Test_AUC",
            lambda x: x[
                df.loc[
                    x.index,
                    "Model"
                ] == "Gradient Boosting"
            ].iloc[0]
        )
    )
    .reset_index()
)


# ================================================================
# 8. QUALIFICATION FLAGS
# ================================================================

disease_summary["RF_CV_Qualified"] = (
    disease_summary["RF_CV_AUC"]
    > THRESHOLD
)

disease_summary["GB_CV_Qualified"] = (
    disease_summary["GB_CV_AUC"]
    > THRESHOLD
)

disease_summary["Disease_Qualified"] = (
    disease_summary["RF_CV_Qualified"]
    |
    disease_summary["GB_CV_Qualified"]
)


# ================================================================
# 9. WHICH CLASSIFIER QUALIFIES EACH DISEASE?
# ================================================================

