# ================================================================
# 7. RUN ALL 10 DISEASES
# ================================================================

for disease in ABUNDANCE_FILES:

    print("\n")
    print("=" * 100)
    print(disease.upper())
    print("=" * 100)

    # ------------------------------------------------------------
    # LOAD ABUNDANCE
    # ------------------------------------------------------------

    abundance = pd.read_csv(
        ABUNDANCE_FILES[disease],
        sep="\t",
        dtype=object
    )

    if "name" not in abundance.columns:
        raise ValueError(
            f"{disease}: 'name' column missing."
        )

    abundance["name"] = (
        abundance["name"]
        .astype(str)
        .str.strip()
    )

    # ------------------------------------------------------------
    # 20 samples
    # ------------------------------------------------------------

    if len(abundance) != 20:
        raise ValueError(
            f"{disease}: expected 20 samples; "
            f"found {len(abundance)}."
        )

    if abundance["name"].duplicated().any():
        raise ValueError(
            f"{disease}: duplicate sample IDs."
        )

    # ------------------------------------------------------------
    # HOST MUST ALREADY BE REMOVED
    # ------------------------------------------------------------

    if "Homo sapiens" in abundance.columns:
        raise ValueError(
            f"{disease}: Homo sapiens is still present."
        )

    species = [
        c for c in abundance.columns
        if c != "name"
    ]

    if len(species) < 30:
        raise ValueError(
            f"{disease}: fewer than 30 taxa."
        )

    # ------------------------------------------------------------
    # NUMERIC
    # ------------------------------------------------------------

    abundance[species] = (
        abundance[species]
        .apply(pd.to_numeric, errors="coerce")
    )

    if abundance[species].isna().any().any():
        raise ValueError(
            f"{disease}: non-numeric abundance values."
        )

    # ------------------------------------------------------------
    # LOAD METADATA
    # ------------------------------------------------------------

    metadata = pd.read_excel(
        METADATA_FILES[disease],
        dtype=object
    )

    if "run id" not in metadata.columns:
        raise ValueError(
            f"{disease}: 'run id' missing."
        )

    if "label" not in metadata.columns:
        raise ValueError(
            f"{disease}: 'label' missing."
        )

    metadata["run id"] = (
        metadata["run id"]
        .astype(str)
        .str.strip()
    )

    metadata["label"] = (
        metadata["label"]
        .apply(clean_binary_label)
    )

    if metadata["label"].isna().any():
        raise ValueError(
            f"{disease}: invalid labels after cleaning."
        )

    metadata["label"] = (
        metadata["label"]
        .astype(int)
    )

    if len(metadata) != 20:
        raise ValueError(
            f"{disease}: metadata does not contain 20 samples."
        )

    # ------------------------------------------------------------
    # EXACTLY 10 / 10
    # ------------------------------------------------------------

    if (metadata["label"] == 0).sum() != 10:
        raise ValueError(
            f"{disease}: Healthy count is not 10."
        )

    if (metadata["label"] == 1).sum() != 10:
        raise ValueError(
            f"{disease}: Disease count is not 10."
        )

    # ------------------------------------------------------------
    # EXACT SAMPLE MATCH
    # ------------------------------------------------------------

    abundance_ids = set(
        abundance["name"]
    )

    metadata_ids = set(
        metadata["run id"]
    )

    if abundance_ids != metadata_ids:

        raise ValueError(
            f"{disease}: abundance/metadata sample mismatch.\n"
            f"Missing from abundance: "
            f"{metadata_ids - abundance_ids}\n"
            f"Missing from metadata: "
            f"{abundance_ids - metadata_ids}"
        )

    # ------------------------------------------------------------
    # ALIGN ABUNDANCE TO METADATA
    # ------------------------------------------------------------

    abundance = (
        abundance
        .set_index("name")
        .loc[metadata["run id"]]
    )

    X = abundance[species].copy()

    y = (
        metadata["label"]
        .reset_index(drop=True)
    )

    print("Samples:", len(X))
    print("Corrected non-zero species:", len(species))
    print("Healthy:", int((y == 0).sum()))
    print("Disease:", int((y == 1).sum()))

    # ============================================================
    # HOLD-OUT COHORT
    # ============================================================

    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.20,
        stratify=y,
        random_state=42
    )

    if len(X_train) != 16 or len(X_test) != 4:
        raise ValueError(
            f"{disease}: incorrect hold-out sizes."
        )

    print("Training samples:", len(X_train))
    print("Testing samples:", len(X_test))

    # ============================================================
    # MODELS
    # ============================================================

    models = {

        "Random Forest":
            RandomForestClassifier(
                random_state=42
            ),

        "Gradient Boosting":
            GradientBoostingClassifier(
                random_state=42
            )
    }

    # ============================================================
    # 5-FOLD CV
    #
    # SelectKBest is INSIDE pipeline:
    # feature selection occurs independently inside each fold.
    # ============================================================

    cv = StratifiedKFold(
        n_splits=5,
        shuffle=True,
        random_state=42
    )

    for model_name, model in models.items():

        pipeline = Pipeline([
            (
                "selector",
                SelectKBest(
                    score_func=f_classif,
                    k=30
                )
            ),
            (
                "model",
                model
            )
        ])

        cv_scores = cross_val_score(
            pipeline,
            X_train,
            y_train,
            cv=cv,
            scoring="roc_auc",
            n_jobs=-1
        )

        cv_auc = float(
            np.mean(cv_scores)
        )

        cv_sd = float(
            np.std(cv_scores, ddof=1)
        )

        for fold, score in enumerate(
            cv_scores,
            start=1
        ):

            cv_records.append({
                "Disease": disease,
                "Model": model_name,
                "Fold": fold,
                "CV_AUC": score
            })

        # ========================================================
        # FINAL TRAINING-ONLY FEATURE SELECTION
        # ========================================================

        selector = SelectKBest(
            score_func=f_classif,
            k=30
        )

        X_train_selected = (
            selector.fit_transform(
                X_train,
                y_train
            )
        )

        X_test_selected = (
            selector.transform(
                X_test
            )
        )

        selected_features = (
            X.columns[
                selector.get_support()
            ]
            .tolist()
        )

        if len(selected_features) != 30:
            raise ValueError(
                f"{disease}/{model_name}: "
                "feature selection did not return 30."
            )

        # --------------------------------------------------------
        # FIT
        # --------------------------------------------------------

        model.fit(
            X_train_selected,
            y_train
        )

        # --------------------------------------------------------
        # HOLD-OUT PREDICTIONS
        # --------------------------------------------------------

        test_probability = (
            model.predict_proba(
                X_test_selected
            )[:, 1]
        )

        test_prediction = (
            model.predict(
                X_test_selected
            )
        )

        # --------------------------------------------------------
        # TEST AUC
        # --------------------------------------------------------

        test_auc = roc_auc_score(
            y_test,
            test_probability
        )

        # --------------------------------------------------------
        # ACCURACY
        # --------------------------------------------------------

        test_accuracy = accuracy_score(
            y_test,
            test_prediction
        )

        print(
            f"{model_name:20s} | "
            f"Test AUC = {test_auc:.3f} | "
            f"CV AUC = {cv_auc:.3f} | "
            f"Accuracy = {test_accuracy:.3f}"
        )

        # --------------------------------------------------------
        # STORE
        # --------------------------------------------------------

        results.append({

            "Disease": disease,
            "Model": model_name,
            "Full_species": len(species),
            "Selected_features": 30,
            "Training_samples": 16,
            "Testing_samples": 4,
            "Test_AUC": test_auc,
            "CV_AUC": cv_auc,
            "CV_AUC_SD": cv_sd,
            "Test_Accuracy": test_accuracy
        })

        # --------------------------------------------------------
        # SAVE SELECTED FEATURES
        # --------------------------------------------------------

        model_dir = os.path.join(
            OUTDIR,
            disease,
            model_name.replace(" ", "_")
        )

        os.makedirs(
            model_dir,
            exist_ok=True
        )

        pd.DataFrame({
            "Rank": np.arange(1, 31),
            "microbe": selected_features
        }).to_csv(
            os.path.join(
                model_dir,
                "SELECTED_30_FEATURES.csv"
            ),
            index=False
        )

        # --------------------------------------------------------
        # SAVE EXACT HOLD-OUT COHORT
        # --------------------------------------------------------

        holdout = pd.DataFrame({

            "run_id":
                X_test.index,

            "label":
                y_test.values,

            "condition":
                np.where(
                    y_test.values == 1,
                    "Disease",
                    "Healthy"
                ),

            "probability":
                test_probability,

            "prediction":
                test_prediction
        })

        holdout.to_csv(
            os.path.join(
                model_dir,
                "HOLDOUT_TEST_COHORT.csv"
            ),
            index=False
        )


