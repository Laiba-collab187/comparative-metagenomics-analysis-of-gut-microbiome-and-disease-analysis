# =====================================================================
# REFERENCE-STYLE HEATMAP FUNCTION
# =====================================================================

def make_reference_heatmap(
    matrix,
    filename,
    panel_label,
    main_title,
    group_label
):

    # ---------------------------------------------------------------
    # taxa × disease
    #
    # Convert to:
    # disease × taxa
    # ---------------------------------------------------------------

    data = matrix.T

    n_diseases = data.shape[0]
    n_species = data.shape[1]

    # ---------------------------------------------------------------
    # VERY LARGE CANVAS
    #
    # 27 pt microbial labels require substantial horizontal space.
    # ---------------------------------------------------------------

    width = max(
        28,
        min(
            58,
            n_species * 1.35
        )
    )

    height = 11.5

    fig, ax = plt.subplots(
        figsize=(
            width,
            height
        )
    )

    # ---------------------------------------------------------------
    # HEATMAP
    # ---------------------------------------------------------------

    image = ax.imshow(
        data.values,
        cmap="RdBu_r",
        vmin=-MAX_LFC,
        vmax=MAX_LFC,
        aspect="auto",
        interpolation="nearest"
    )

    # ---------------------------------------------------------------
    # Y AXIS — DISEASES
    # ---------------------------------------------------------------

    ax.set_yticks(
        np.arange(
            n_diseases
        )
    )

    ax.set_yticklabels(
        [
            DISPLAY[d]
            for d in DISEASES
        ],
        fontsize=18,
        fontweight="bold"
    )

    # ---------------------------------------------------------------
    # X AXIS — MICROBIAL SPECIES
    #
    # 27 PT + BOLD
    # ---------------------------------------------------------------

    ax.set_xticks(
        np.arange(
            n_species
        )
    )

    ax.set_xticklabels(
        data.columns.astype(str),
        fontsize=27,
        fontweight="bold",
        rotation=90,
        ha="center",
        va="top"
    )

    # ---------------------------------------------------------------
    # BLACK TICK / CONNECTOR LINES
    #
    # These extend below the x-axis, reproducing the visual logic
    # of the reference article.
    # ---------------------------------------------------------------

    ax.tick_params(
        axis="x",
        which="major",
        bottom=True,
        top=False,
        direction="out",
        length=16,
        width=1.8,
        colors="black",
        pad=8
    )

    ax.tick_params(
        axis="y",
        which="major",
        left=True,
        right=False,
        direction="out",
        length=8,
        width=1.5,
        colors="black"
    )

    # ---------------------------------------------------------------
    # BLACK BORDER AROUND EVERY CELL
    #
    # Minor grid lines are placed directly on cell boundaries.
    # ---------------------------------------------------------------

    ax.set_xticks(
        np.arange(
            -0.5,
            n_species,
            1
        ),
        minor=True
    )

    ax.set_yticks(
        np.arange(
            -0.5,
            n_diseases,
            1
        ),
        minor=True
    )

    ax.grid(
        which="minor",
        color="black",
        linestyle="-",
        linewidth=0.75
    )

    ax.tick_params(
        which="minor",
        bottom=False,
        left=False
    )

    # ---------------------------------------------------------------
    # KEEP THE MAIN AXES BORDER BLACK
    # ---------------------------------------------------------------

    for spine in ax.spines.values():

        spine.set_visible(True)

        spine.set_color("black")

        spine.set_linewidth(1.4)

    # ---------------------------------------------------------------
    # Y AXIS TITLE
    # ---------------------------------------------------------------

    ax.set_ylabel(
        "Disease",
        fontsize=20,
        fontweight="bold",
        labelpad=20
    )

    # ---------------------------------------------------------------
    # X AXIS TITLE
    # ---------------------------------------------------------------

    ax.set_xlabel(
        group_label,
        fontsize=20,
        fontweight="bold",
        labelpad=42
    )

    # ---------------------------------------------------------------
    # PANEL LABEL
    # ---------------------------------------------------------------

    ax.text(
        -0.075,
        1.035,
        panel_label,
        transform=ax.transAxes,
        fontsize=22,
        fontweight="bold",
        ha="left",
        va="bottom"
    )

    # ---------------------------------------------------------------
    # MAIN TITLE
    # ---------------------------------------------------------------

    ax.set_title(
        main_title,
        fontsize=23,
        fontweight="bold",
        pad=30
    )

    # ---------------------------------------------------------------
    # COLORBAR
    # ---------------------------------------------------------------

    cbar = fig.colorbar(
        image,
        ax=ax,
        fraction=0.025,
        pad=0.025
    )

    cbar.set_label(
        "log₂ fold change",
        fontsize=18,
        fontweight="bold",
        labelpad=12
    )

    cbar.ax.tick_params(
        labelsize=14,
        width=1.2
    )

    # ---------------------------------------------------------------
    # COLORBAR BORDER
    # ---------------------------------------------------------------

    cbar.outline.set_edgecolor(
        "black"
    )

    cbar.outline.set_linewidth(
        1.2
    )

    # ---------------------------------------------------------------
    # LARGE LOWER MARGIN
    #
    # Allows 27 pt rotated microbial names + connector lines.
    # ---------------------------------------------------------------

    plt.subplots_adjust(
        left=0.14,
        right=0.955,
        top=0.84,
        bottom=0.48
    )

    # ---------------------------------------------------------------
    # SAVE HIGH-RESOLUTION VECTOR SVG
    # ---------------------------------------------------------------

    output = (
        OUT_DIR /
        filename
    )

    fig.savefig(
        output,
        format="svg",
        bbox_inches="tight",
        facecolor="white"
    )

    plt.close(fig)

    print(
        f"SAVED: {output}"
    )


