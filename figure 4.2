    # Sort taxa by:
    # 1. number of diseases
    # 2. alphabetical name
    taxa = sorted(
        recurrent_taxa.keys(),
        key=lambda x: (
            -recurrent_taxa[x],
            x
        )
    )

    mat = pd.DataFrame(
        np.nan,
        index=DISEASES,
        columns=taxa
    )

    for disease in DISEASES:

        series = lfc_data[disease]

        for taxon in taxa:

            if taxon in series.index:

                mat.loc[
                    disease,
                    taxon
                ] = series.loc[taxon]

    return mat


