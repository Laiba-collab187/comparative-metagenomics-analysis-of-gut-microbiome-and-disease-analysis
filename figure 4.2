# =====================================================================
# HEATMAP FUNCTION
# =====================================================================

def generate_heatmap(
    matrix,
    filename,
    title,
    x_label
):

    # ---------------------------------------------------------------
    # Matrix:
    # taxa × diseases
    #
    # Display:
    # diseases × taxa
    # ---------------------------------------------------------------

    plot_data = matrix.T

    n_taxa = plot_data.shape[1]

    # ---------------------------------------------------------------
    # EXTRA WIDTH FOR 16 PT TAXON LABELS
    # ---------------------------------------------------------------

    fig_width = max(
        24,
        min(
            42,
            n_taxa * 0.90
        )
    )

    fig, ax = plt.subplots(
        figsize=(
            fig_width,
            10
        )
    )

    # ---------------------------------------------------------------
    # LFC HEATMAP
    # ---------------------------------------------------------------

    im = ax.imshow(
        plot_data.values,
        aspect="auto",
        cmap="RdBu_r",
        vmin=-MAX_LFC,
        vmax=MAX_LFC,
        interpolation="nearest"
    )

    # ---------------------------------------------------------------
    # DISEASE LABELS
    # 15 PT + BOLD
    # ---------------------------------------------------------------

    ax.set_yticks(
        np.arange(10)
    )

    ax.set_yticklabels(
        [
            DISPLAY[d]
            for d in DISEASES
        ],
        fontsize=15,
        fontweight="bold"
    )

    # ---------------------------------------------------------------
    # MICROBIAL SPECIES
    # 16 PT + BOLD
    # ---------------------------------------------------------------

    ax.set_xticks(
        np.arange(n_taxa)
    )

    ax.set_xticklabels(
        plot_data.columns.astype(str),
        rotation=65,
        ha="right",
        fontsize=16,
        fontweight="bold"
    )

    # ---------------------------------------------------------------
    # X AXIS LABEL
    # ---------------------------------------------------------------

    ax.set_xlabel(
        x_label,
        fontsize=18,
        fontweight="bold",
        labelpad=20
    )

    # ---------------------------------------------------------------
    # Y AXIS LABEL
    # ---------------------------------------------------------------

    ax.set_ylabel(
        "Disease",
        fontsize=18,
        fontweight="bold",
        labelpad=18
    )

    # ---------------------------------------------------------------
    # TITLE
    # ---------------------------------------------------------------

    ax.set_title(
        title,
        fontsize=21,
        fontweight="bold",
        pad=24
    )

    # ---------------------------------------------------------------
    # WHITE GRID BETWEEN CELLS
    # ---------------------------------------------------------------

    ax.set_xticks(
        np.arange(
            -0.5,
            n_taxa,
            1
        ),
        minor=True
    )

    ax.set_yticks(
        np.arange(
            -0.5,
            10,
            1
        ),
        minor=True
    )

    ax.grid(
        which="minor",
        color="white",
        linewidth=0.6,
        alpha=0.7
    )

    ax.tick_params(
        which="minor",
        bottom=False,
        left=False
    )

    # ---------------------------------------------------------------
    # COLORBAR
    # ---------------------------------------------------------------

    cbar = fig.colorbar(
        im,
        ax=ax,
        fraction=0.025,
        pad=0.025
    )

    cbar.set_label(
        "log2 fold change",
        fontsize=16,
        fontweight="bold"
    )

    cbar.ax.tick_params(
        labelsize=13
    )

    # ---------------------------------------------------------------
    # LAYOUT
    # ---------------------------------------------------------------

    plt.subplots_adjust(
        left=0.14,
        right=0.96,
        top=0.88,
        bottom=0.40
    )

    # ---------------------------------------------------------------
    # SAVE VECTOR SVG
    # ---------------------------------------------------------------

    output_path = (
        OUT_DIR /
        filename
    )

    fig.savefig(
        output_path,
        format="svg",
        bbox_inches="tight"
    )

    plt.close(fig)

    print(
        f"SAVED: {output_path}"
    )


