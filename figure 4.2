def make_pair_rank_plot(
    disease_a,
    disease_b,
    group,
    filename,
    panel_label
):

    case_shared, control_shared = pair_overlap(
        disease_a,
        disease_b
    )

    if group == "case":

        shared = case_shared

        colour = "salmon"

        group_text = "Case-associated"

    else:

        shared = control_shared

        colour = "steelblue"

        group_text = "Control-associated"


    # ---------------------------------------------------------------
    # Obtain rank for each shared taxon
    # ---------------------------------------------------------------

    if group == "case":

        list_a = top100_cache[
            (disease_a, "case")
        ]

        list_b = top100_cache[
            (disease_b, "case")
        ]

    else:

        list_a = top100_cache[
            (disease_a, "control")
        ]

        list_b = top100_cache[
            (disease_b, "control")
        ]


    rank_a = {
        taxon: i + 1
        for i, taxon in enumerate(list_a)
    }

    rank_b = {
        taxon: i + 1
        for i, taxon in enumerate(list_b)
    }


    taxa = list(shared)

    y_a = [
        rank_a[x]
        for x in taxa
    ]

    y_b = [
        rank_b[x]
        for x in taxa
    ]


    # ---------------------------------------------------------------
    # Large canvas
    # ---------------------------------------------------------------

    fig_width = max(
        18,
        len(taxa) * 0.75
    )

    fig_height = 12

