# =====================================================================
# ROBUST ORIENTATION CORRECTION
#
# Your actual matrix is:
#
# CASE    = 10 diseases × 53 taxa
# CONTROL = 10 diseases × 68 taxa
#
# We convert it to:
#
# CASE    = 53 taxa × 10 diseases
# CONTROL = 68 taxa × 10 diseases
#
# This is exactly the structure needed for the heatmap:
# rows = recurrent taxa
# columns = diseases
# =====================================================================

def orient_recurrent_matrix(
    df,
    expected_taxa,
    label
):

    # -------------------------------------------------------------
    # CASE 1:
    # disease names are columns
    # -------------------------------------------------------------

    normalized_columns = {
        str(c).strip(): c
        for c in df.columns
    }

    disease_columns = []

    for disease in DISEASES:

        if disease in normalized_columns:

            disease_columns.append(
                normalized_columns[disease]
            )

        elif DISPLAY[disease] in normalized_columns:

            disease_columns.append(
                normalized_columns[DISPLAY[disease]]
            )

    if len(disease_columns) == 10:

        # Rows should be taxa.
        result = df[disease_columns].copy()

        result.columns = DISEASES

        print(
            f"\n{label}: detected TAXA × DISEASE orientation."
        )

    else:

        # ---------------------------------------------------------
        # CASE 2:
        # disease names are rows
        # ---------------------------------------------------------

        normalized_index = {
            str(i).strip(): i
            for i in df.index
        }

        disease_rows = []

        for disease in DISEASES:

            if disease in normalized_index:

                disease_rows.append(
                    normalized_index[disease]
                )

            elif DISPLAY[disease] in normalized_index:

                disease_rows.append(
                    normalized_index[DISPLAY[disease]]
                )

        if len(disease_rows) != 10:

            raise ValueError(
                f"\nCould not identify all 10 disease labels "
                f"in {label} recurrent matrix.\n"
                f"Rows: {list(df.index)}\n"
                f"Columns: {list(df.columns)}"
            )

        result = df.loc[disease_rows].copy()

        result.index = DISEASES

        result = result.T

        print(
            f"\n{label}: detected DISEASE × TAXA orientation."
        )

    # -------------------------------------------------------------
    # Convert all values to numeric
    # -------------------------------------------------------------

    result = result.apply(
        pd.to_numeric,
        errors="coerce"
    )

    # -------------------------------------------------------------
    # Remove accidental empty taxa columns/rows
    # -------------------------------------------------------------

    result = result.loc[
        result.index.astype(str).str.strip() != ""
    ]

    result = result.loc[
        result.index.astype(str).str.lower() != "nan"
    ]

    # -------------------------------------------------------------
    # Check disease columns
    # -------------------------------------------------------------

    if list(result.columns) != DISEASES:

        result = result.reindex(
            columns=DISEASES
        )

    # -------------------------------------------------------------
    # FINAL EXPECTED TAXA COUNT
    # -------------------------------------------------------------

    if len(result) != expected_taxa:

        raise ValueError(
            f"\n{label} recurrent taxa count is incorrect.\n"
            f"Expected: {expected_taxa}\n"
            f"Found: {len(result)}\n"
            f"Final shape: {result.shape}"
        )

    # -------------------------------------------------------------
    # Remove taxa with no usable LFC values
    # -------------------------------------------------------------

    if result.isna().all(axis=1).any():

        bad = result.index[
            result.isna().all(axis=1)
        ].tolist()

        raise ValueError(
            f"{label}: taxa with all missing LFC values:\n{bad}"
        )

    return result


