    ):

        a = DISEASES[i]
        b = DISEASES[j]

        case_overlap = len(
            set(
                load_signature(a, "case")
            ).intersection(
                load_signature(b, "case")
            )
        )

        control_overlap = len(
            set(
                load_signature(a, "control")
            ).intersection(
                load_signature(b, "control")
            )
        )

        case_matrix.loc[a, b] = case_overlap
        case_matrix.loc[b, a] = case_overlap

        control_matrix.loc[a, b] = control_overlap
        control_matrix.loc[b, a] = control_overlap


