# ============================================================
# FIGURE 3E AND 3F LFC MATRICES
# ============================================================

case_lfc = pd.read_csv(
    "Figure3e_Case_Shared_Microbes_LFC_Matrix.csv",
    index_col=0
)

control_lfc = pd.read_csv(
    "Figure3f_Control_Shared_Microbes_LFC_Matrix.csv",
    index_col=0
)


def plot_lfc_matrix(
    matrix,
    title,
    xlabel,
    output_file
):

    masked_matrix = np.ma.masked_invalid(
        matrix.values
    )

    fig, ax = plt.subplots(
        figsize=(26, 5)
    )

    image = ax.imshow(
        masked_matrix,
        aspect="auto"
    )

    ax.set_yticks(
        np.arange(
            len(matrix.index)
        )
    )

    ax.set_yticklabels(
        matrix.index
    )

    ax.set_xticks(
        np.arange(
            len(matrix.columns)
        )
    )

    ax.set_xticklabels(
        matrix.columns,
        rotation=90,
        fontsize=6
    )

    ax.set_ylabel(
        "Disease"
    )

    ax.set_xlabel(
        xlabel
    )

    ax.set_title(
        title
    )

    colorbar = fig.colorbar(
        image,
        ax=ax
    )

    colorbar.set_label(
        r"$\log_2$ fold change"
    )

    plt.tight_layout()

    plt.savefig(
        output_file,
        dpi=300,
        bbox_inches="tight"
    )

    plt.close()


plot_lfc_matrix(
    case_lfc,
    "Case-associated microbes shared by more than two diseases",
    "Case-associated microbial species",
    "Figure_3e_Case_Shared_Microbes_LFC.png"
)


plot_lfc_matrix(
    control_lfc,
    "Control-associated microbes shared by more than two diseases",
    "Control-associated microbial species",
    "Figure_3f_Control_Shared_Microbes_LFC.png"
)


