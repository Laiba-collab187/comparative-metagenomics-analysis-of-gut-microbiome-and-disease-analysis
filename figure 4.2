# =====================================================================

def prepare_matrix(
    df,
    expected_taxa,
    label
):

    # ---------------------------------------------------------------
    # Remove accidental whitespace from column names
    # ---------------------------------------------------------------

    df.columns = [
        str(c).strip()
        for c in df.columns
    ]

    # ---------------------------------------------------------------
    # CASE 1:
    # taxa × diseases
    # ---------------------------------------------------------------

    disease_columns = [
        d for d in DISEASES
        if d in df.columns
    ]

    if len(disease_columns) == 10:

        result = df[
            disease_columns
        ].copy()

        result.columns = DISEASES

        print(
            f"{label}: taxa × disease orientation VERIFIED"
        )

    else:

        # -----------------------------------------------------------
        # CASE 2:
        # diseases × taxa
        # -----------------------------------------------------------

        index_values = [
            str(x).strip()
            for x in df.index
        ]

        disease_positions = {}

        for disease in DISEASES:

            if disease in index_values:

                disease_positions[disease] = (
                    index_values.index(disease)
                )

        if len(disease_positions) != 10:

            raise ValueError(
                f"\n{label}: Could not identify all 10 diseases."
            )

        selected_rows = [
            df.index[
                disease_positions[d]
            ]
            for d in DISEASES
        ]

        result = df.loc[
            selected_rows
        ].copy()

        result.index = DISEASES

        result = result.T

        print(
            f"{label}: disease × taxa orientation detected "
            f"and corrected"
        )

    # ---------------------------------------------------------------
    # Numeric conversion
    # ---------------------------------------------------------------

    result = result.apply(
        pd.to_numeric,
        errors="coerce"
    )

    # ---------------------------------------------------------------
    # Disease order
    # ---------------------------------------------------------------

    result = result.reindex(
        columns=DISEASES
    )

    # ---------------------------------------------------------------
    # Final dimensions
    # ---------------------------------------------------------------

    if result.shape != (
        expected_taxa,
        10
    ):

        raise ValueError(
            f"\n{label} matrix has incorrect dimensions.\n"
            f"Expected: {(expected_taxa, 10)}\n"
            f"Found: {result.shape}"
        )

    # ---------------------------------------------------------------
    # No duplicated taxa
    # ---------------------------------------------------------------

    if result.index.duplicated().any():

        duplicated = result.index[
            result.index.duplicated()
        ].tolist()

        raise ValueError(
            f"{label}: duplicated microbial taxa found:\n"
            f"{duplicated}"
        )

    return result


