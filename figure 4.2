def make_overlap_matrix(direction):

    sets = {}

    for disease in DISEASES:
        sets[disease] = set(
            TOP100[disease][direction]["species"]
        )

    matrix = pd.DataFrame(
        0,
        index=DISEASES,
        columns=DISEASES,
        dtype=int
    )

    for a in DISEASES:
        for b in DISEASES:
            matrix.loc[a, b] = len(
                sets[a] & sets[b]
            )

    return matrix


