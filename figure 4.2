# =====================================================================

def load_top100(
    disease,
    group
):

    if group == "case":

        filename = (
            f"{disease}_TOP100_DISEASE_ENRICHED_CORRECTED.csv"
        )

    else:

        filename = (
            f"{disease}_TOP100_HEALTHY_ENRICHED_CORRECTED.csv"
        )

    path = TOP100_DIR / filename

    if not path.exists():

        raise FileNotFoundError(
            f"\nTOP-100 FILE NOT FOUND:\n{path}"
        )

    df = pd.read_csv(
        path
    )

    # ---------------------------------------------------------------
    # Identify microbial species column robustly
    # ---------------------------------------------------------------

    possible_taxon_columns = [
        "microbe",
        "Microbe",
        "taxa",
        "Taxa",
        "species",
        "Species",
        "feature",
        "Feature"
    ]

    taxon_col = None

    for col in possible_taxon_columns:

        if col in df.columns:

            taxon_col = col
            break

    if taxon_col is None:

        # first column is normally the taxon column
        taxon_col = df.columns[0]

    taxa = (
        df[taxon_col]
        .astype(str)
        .str.strip()
    )

    taxa = (
        taxa[
            taxa != ""
        ]
        .drop_duplicates()
        .tolist()
    )

    if len(taxa) != 100:

        raise ValueError(
            f"{disease} {group}: "
            f"expected 100 taxa, found {len(taxa)}"
        )

    return taxa


