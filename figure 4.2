# 19. COMMON HEATMAP FUNCTION
# ============================================================

def make_recurrent_heatmap(
    mat,
    panel_letter,
    title,
    filename,
    cmap
):

    # Limit figure width according to number of species
    n_species = len(mat.columns)

    width = max(
        13,
        min(34, 0.38 * n_species + 6)
    )

    fig, ax = plt.subplots(
        figsize=(width, 7.5),
        dpi=300
    )

    # Symmetric LFC scale
    vals = mat.values[
        np.isfinite(mat.values)
    ]

    if len(vals) == 0:
        raise ValueError(
            f"No LFC values available for {title}"
        )

    max_abs = np.nanmax(
        np.abs(vals)
    )

    if max_abs == 0:
        max_abs = 1

    norm = Normalize(
        vmin=-max_abs,
        vmax=max_abs
    )

    im = ax.imshow(
        mat.values,
        aspect="auto",
        interpolation="nearest",
        cmap=cmap,
        norm=norm
    )

    # --------------------------------------------------------
    # Axes
    # --------------------------------------------------------

    ax.set_yticks(
        np.arange(len(DISEASES))
    )

    ax.set_yticklabels(
        [display_names[d] for d in DISEASES],
        fontsize=11
    )

    ax.set_xticks(
        np.arange(len(mat.columns))
    )

    ax.set_xticklabels(
        mat.columns,
        rotation=65,
        ha="right",
        fontsize=8
    )

    ax.set_xlabel(
        "Microbial species",
        fontsize=13,
        fontweight="bold"
    )

    ax.set_ylabel(
        "Disease",
        fontsize=13,
        fontweight="bold"
    )

    ax.set_title(
        title,
        fontsize=15,
        fontweight="bold",
        pad=14
    )

    # --------------------------------------------------------
    # Cell borders
    # --------------------------------------------------------

    ax.set_xticks(
        np.arange(-0.5, len(mat.columns), 1),
        minor=True
    )

    ax.set_yticks(
        np.arange(-0.5, len(DISEASES), 1),
        minor=True
    )

    ax.grid(
        which="minor",
        color="white",
        linewidth=0.5
    )

    ax.tick_params(
        which="minor",
        bottom=False,
        left=False
    )

    # --------------------------------------------------------
    # Colorbar
    # --------------------------------------------------------

    cbar = fig.colorbar(
        im,
        ax=ax,
        fraction=0.025,
        pad=0.02
    )

    cbar.set_label(
        "log2 fold change (LFC)",
        fontsize=12,
        fontweight="bold"
    )

    cbar.ax.tick_params(
        labelsize=10
    )

    # --------------------------------------------------------
    # Panel label
    # --------------------------------------------------------

    ax.text(
        -0.06,
        1.04,
        panel_letter,
        transform=ax.transAxes,
        fontsize=20,
        fontweight="bold"
    )

    fig.tight_layout()

    path = os.path.join(
        OUT,
        filename
    )

    fig.savefig(
        path,
        format="svg",
        bbox_inches="tight"
    )

    plt.close(fig)

    return path


