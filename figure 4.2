# =====================================================================
# ORIENTATION FUNCTION
# =====================================================================

def orient_matrix(
    df,
    expected_taxa,
    label
):

    # ---------------------------------------------------------------
    # Detect disease columns
    # ---------------------------------------------------------------

    column_map = {
        str(c).strip(): c
        for c in df.columns
    }

    disease_columns = []

    for disease in DISEASES:

        if disease in column_map:

            disease_columns.append(
                column_map[disease]
            )

        elif DISPLAY[disease] in column_map:

            disease_columns.append(
                column_map[DISPLAY[disease]]
            )

    # ---------------------------------------------------------------
    # TAXA × DISEASE
    # ---------------------------------------------------------------

    if len(disease_columns) == 10:

        result = df[
            disease_columns
        ].copy()

        result.columns = DISEASES

        print(
            f"{label}: taxa × disease detected."
        )

    # ---------------------------------------------------------------
    # DISEASE × TAXA
    # ---------------------------------------------------------------

    else:

        index_map = {
            str(i).strip(): i
            for i in df.index
        }

        disease_rows = []

        for disease in DISEASES:

            if disease in index_map:

                disease_rows.append(
                    index_map[disease]
                )

            elif DISPLAY[disease] in index_map:

                disease_rows.append(
                    index_map[DISPLAY[disease]]
                )

        if len(disease_rows) != 10:

            raise ValueError(
                f"{label}: could not identify all 10 diseases."
            )

        result = df.loc[
            disease_rows
        ].copy()

        result.index = DISEASES

        result = result.T

        print(
            f"{label}: disease × taxa detected; "
            f"transposed for plotting."
        )

    # ---------------------------------------------------------------
    # NUMERIC VALUES
    # ---------------------------------------------------------------

    result = result.apply(
        pd.to_numeric,
        errors="coerce"
    )

    # ---------------------------------------------------------------
    # FINAL ORDER
    # ---------------------------------------------------------------

    result = result.reindex(
        columns=DISEASES
    )

    # ---------------------------------------------------------------
    # FINAL QC
    # ---------------------------------------------------------------

    if result.shape != (
        expected_taxa,
        10
    ):

        raise ValueError(
            f"{label}: incorrect final shape.\n"
            f"Expected {(expected_taxa, 10)}\n"
            f"Found {result.shape}"
        )

    return result


