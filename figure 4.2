# =====================================================================
# 18. LOAD RECURRENT LFC MATRIX ROBUSTLY
# =====================================================================
#
# Expected biological structure:
#
#              Disease1 Disease2 ... Disease10
# Microbe_1       LFC      LFC          LFC
# Microbe_2       LFC      LFC          LFC
# ...
#
# If the saved matrix happens to be transposed, this function detects
# that and corrects orientation for plotting only.
#
# NO biological values are changed.
# =====================================================================

def load_recurrent_lfc_matrix(
    filepath,
    label
):

    df = pd.read_csv(
        filepath
    )

    print("\n" + "=" * 100)
    print(f"LOADING {label.upper()} RECURRENT LFC MATRIX")
    print("=" * 100)

    print(
        f"File: {filepath}"
    )

    print(
        f"Original shape: {df.shape}"
    )

    print(
        f"Columns: {list(df.columns)}"
    )

    # ---------------------------------------------------------------
    # Find disease columns
    # ---------------------------------------------------------------

    disease_columns = [
        d
        for d in DISEASES
        if d in df.columns
    ]

    # ---------------------------------------------------------------
    # Normal expected orientation:
    # rows = microbial species
    # columns = diseases
    # ---------------------------------------------------------------

    if len(disease_columns) >= 8:

        taxon_candidates = [
            c
            for c in df.columns
            if c not in disease_columns
        ]

        if len(taxon_candidates) == 0:

            raise ValueError(
                f"Could not identify species column "
                f"in {filepath}"
            )

        taxon_col = taxon_candidates[0]

        taxa = (
            df[taxon_col]
            .astype(str)
            .str.strip()
        )

        matrix = df[
            disease_columns
        ].apply(
            pd.to_numeric,
            errors="coerce"
        )

        matrix.index = taxa

        # Rename to the standard disease order
        matrix = matrix.reindex(
            columns=[
                d
                for d in DISEASES
                if d in matrix.columns
            ]
        )

    else:

        # -----------------------------------------------------------
        # Possible transposed structure:
        #
        # first column = Disease
        # remaining columns = microbial taxa
        # -----------------------------------------------------------

        first_col = df.columns[0]

        if (
            df[first_col]
            .astype(str)
            .isin(DISEASES)
            .sum()
            >= 8
        ):

            df2 = df.set_index(
                first_col
            )

            matrix = df2[
                [
                    c
                    for c in df2.columns
                ]
            ].apply(
                pd.to_numeric,
                errors="coerce"
            )

            matrix = matrix.loc[
                [
                    d
                    for d in DISEASES
                    if d in matrix.index
                ]
            ].T

            matrix.index.name = (
                "Microbial_species"
            )

        else:

            raise ValueError(
                f"\nCould not determine orientation "
                f"of recurrent LFC matrix:\n{filepath}\n\n"
                f"Columns:\n{list(df.columns)}"
            )

    # ---------------------------------------------------------------
    # Remove completely empty taxa
    # ---------------------------------------------------------------

    matrix = matrix.dropna(
        how="all"
    )

    # ---------------------------------------------------------------
    # Ensure exactly the disease columns available
    # ---------------------------------------------------------------

    matrix = matrix.reindex(
        columns=[
            d
            for d in DISEASES
            if d in matrix.columns
        ]
    )

    if len(matrix.columns) != 10:

        raise ValueError(
            f"\nExpected LFC matrix with 10 diseases.\n"
            f"Found columns:\n{list(matrix.columns)}"
        )

    print(
        f"Final matrix shape: {matrix.shape}"
    )

    print(
        f"Number of recurrent taxa: {len(matrix)}"
    )

    return matrix


