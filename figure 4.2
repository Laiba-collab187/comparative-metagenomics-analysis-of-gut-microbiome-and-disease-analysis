# =====================================================================

def make_recurrent_heatmap(
    matrix,
    output_name,
    title,
    x_label
):

    # matrix:
    # taxa × diseases
    #
    # plot:
    # diseases on y-axis
    # taxa on x-axis

    plot_data = matrix.T

    n_taxa = plot_data.shape[1]

    # Large width prevents microbial names from overlapping.
    fig_width = max(
        15,
        min(
            28,
            n_taxa * 0.55
        )
    )

    fig, ax = plt.subplots(
        figsize=(fig_width, 8)
    )

    im = ax.imshow(
        plot_data.values,
        aspect="auto",
        cmap="RdBu_r",
        vmin=-global_max,
        vmax=global_max,
        interpolation="nearest"
    )

    # -------------------------------------------------------------
    # Y AXIS = DISEASES
    # -------------------------------------------------------------

    ax.set_yticks(
        np.arange(len(DISEASES))
    )

    ax.set_yticklabels(
        [
            DISPLAY[d]
            for d in DISEASES
        ],
        fontsize=12,
        fontweight="bold"
    )

    # -------------------------------------------------------------
    # X AXIS = MICROBES
    # -------------------------------------------------------------

    ax.set_xticks(
        np.arange(n_taxa)
    )

    ax.set_xticklabels(
        plot_data.columns.astype(str),
        rotation=70,
        ha="right",
        fontsize=10,
        fontweight="bold"
    )

    # -------------------------------------------------------------
    # AXIS LABELS
    # -------------------------------------------------------------

    ax.set_xlabel(
