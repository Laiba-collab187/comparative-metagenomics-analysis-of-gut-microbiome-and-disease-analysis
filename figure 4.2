def rank_dict(
    disease,
    direction
):

    df = TOP100[disease][direction]

    return dict(
        zip(
            df["species"],
            df["rank"]
        )
    )


def save_pair_graph(
    disease_a,
    disease_b,
    direction,
    panel,
    filename
):

    ranks_a = rank_dict(
        disease_a,
        direction
    )

    ranks_b = rank_dict(
        disease_b,
        direction
    )

    shared = sorted(
        set(ranks_a) & set(ranks_b),
        key=lambda x:
            ranks_a[x] + ranks_b[x]
    )

    if len(shared) == 0:
        raise ValueError(
            f"No shared taxa for "
