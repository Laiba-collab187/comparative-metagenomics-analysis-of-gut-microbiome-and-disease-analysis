def make_rank_figure(
    disease_a,
    disease_b,
    group,
    filename,
    panel
):

    taxa_a = load_signature(
        disease_a,
        group
    )

    taxa_b = load_signature(
        disease_b,
        group
    )

    rank_a = {
        taxon: i + 1
        for i, taxon in enumerate(taxa_a)
    }

    rank_b = {
        taxon: i + 1
        for i, taxon in enumerate(taxa_b)
    }

    shared = [
        taxon
        for taxon in taxa_a
        if taxon in rank_b
    ]

    ranks_a = [
        rank_a[taxon]
        for taxon in shared
    ]

    ranks_b = [
        rank_b[taxon]
        for taxon in shared
    ]

    n = len(shared)

    if group == "case":

        point_color = "salmon"
        group_label = "Case-associated microbes"

    else:

        point_color = "steelblue"
        group_label = "Control-associated microbes"

    fig_width = max(
        18,
        n * 0.82
    )

    fig, ax = plt.subplots(
        figsize=(
            fig_width,
            11
        )
    )

    x = np.arange(n)

    # ---------------------------------------------------------------
    # LIGHT DOTTED VERTICAL MICROBE SEPARATORS
    # ---------------------------------------------------------------

    for xpos in x:

        ax.axvline(
            xpos,
            color="lightgray",
            linestyle=":",
            linewidth=0.9,
            alpha=0.9,
            zorder=0
        )

    # ---------------------------------------------------------------
    # BLACK RANK CONNECTIONS
    # ---------------------------------------------------------------

    for i in range(n):

        ax.plot(
            [x[i], x[i]],
            [ranks_a[i], ranks_b[i]],
            color="black",
            linewidth=1.15,
            linestyle="-",
            zorder=2
        )

    # ---------------------------------------------------------------
    # POINTS
    # ---------------------------------------------------------------

    ax.scatter(
        x,
        ranks_a,
        s=115,
        color=point_color,
        edgecolor="black",
        linewidth=0.9,
        zorder=4
    )

    ax.scatter(
        x,
        ranks_b,
        s=115,
        color=point_color,
        edgecolor="black",
        linewidth=0.9,
        zorder=4
    )

    # ---------------------------------------------------------------
    # MICROBIAL NAMES
    #
    # 27 pt BOLD
    # VERY CLOSE TO X-AXIS
    # ---------------------------------------------------------------

    ax.set_xticks(
        x
    )

    ax.set_xticklabels(
        shared,
        fontsize=27,
        fontweight="bold",
        rotation=90,
        ha="center",
        va="top"
    )

    ax.tick_params(
        axis="x",
        which="major",
        pad=-2,
        length=5,
        width=1.5
    )

    # ---------------------------------------------------------------
    # Y AXIS
    # ---------------------------------------------------------------

    ax.set_ylabel(
        "Microbe rank",
        fontsize=20,
        fontweight="bold"
    )

    ax.set_ylim(
        105,
        0
    )

    ax.set_yticks(
        [1, 20, 40, 60, 80, 100]
    )

    ax.tick_params(
        axis="y",
        labelsize=16,
        width=1.5
    )

    ax.grid(
        axis="y",
        color="lightgray",
        linestyle=":",
        linewidth=0.6,
        alpha=0.55
    )

    # ---------------------------------------------------------------
    # PANEL LETTER
    # ---------------------------------------------------------------

    ax.text(
        -0.045,
        1.025,
        panel,
        transform=ax.transAxes,
        fontsize=24,
        fontweight="bold",
        ha="left",
        va="bottom"
    )

    # ---------------------------------------------------------------
    # DISEASE NAMES
    # ---------------------------------------------------------------

    ax.text(
        0.01,
        0.965,
        DISPLAY[disease_a],
        transform=ax.transAxes,
        fontsize=19,
        fontweight="bold",
        ha="left",
        va="top"
    )

    ax.text(
