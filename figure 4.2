# 14. FIND CORRECTED DESEQ2 FILES
# ============================================================

def find_deseq2_file(disease):

    # Search broadly because exact naming can differ
    patterns = [
        f"{disease}_DESeq2_full_results.csv",
        f"{disease}_DESeq2_full_results_CORRECTED.csv",
        f"{disease}_full_DESeq2_results.csv",
        f"{disease}_DESEQ2_full_results.csv",
        f"{disease}*DESeq2*results*.csv"
    ]

    candidates = []

    for pattern in patterns:

        candidates.extend(
            glob.glob(
                f"/content/**/{pattern}",
                recursive=True
            )
        )

    # Remove duplicates
    candidates = list(dict.fromkeys(candidates))

    if not candidates:

        raise FileNotFoundError(
            f"Could not find corrected DESeq2 file for {disease}"
        )

    # Prefer corrected directories/files
    candidates = sorted(
        candidates,
        key=lambda x: (
            "CORRECTED" not in x.upper(),
            "CORRECTED" not in os.path.basename(x).upper()
        )
    )

    return candidates[0]


# ============================================================
# 15. IDENTIFY DESEQ2 LFC COLUMN
# ============================================================

def identify_lfc_column(df):

    preferred = [
        "log2FoldChange",
        "log2FC",
        "LFC",
        "lfc"
    ]

    for c in preferred:

        if c in df.columns:
            return c

    for c in df.columns:

        cl = str(c).lower()

        if (
            "log2foldchange" in cl
            or "log2fc" in cl
            or cl == "lfc"
        ):
            return c

    raise ValueError(
        "Could not identify log2 fold-change column."
    )


# ============================================================
# 16. LOAD CORRECTED LFC DATA
# ============================================================

lfc_data = {}

for disease in DISEASES:

    f = find_deseq2_file(disease)

    temp = pd.read_csv(f)

    tax_col = identify_taxon_column(temp)
    lfc_col = identify_lfc_column(temp)

    temp = temp[
        [tax_col, lfc_col]
    ].copy()

    temp.columns = [
        "taxon",
        "LFC"
    ]

    temp["taxon"] = (
        temp["taxon"]
        .astype(str)
        .str.strip()
    )

    temp["LFC"] = pd.to_numeric(
        temp["LFC"],
        errors="coerce"
    )

    temp = temp.dropna(
        subset=["LFC"]
    )

    temp = temp.drop_duplicates(
        subset=["taxon"],
        keep="first"
    )

    lfc_data[disease] = (
        temp.set_index("taxon")["LFC"]
    )

    print(
        f"{disease:<25} "
        f"LFC values loaded = {len(lfc_data[disease])}"
    )


