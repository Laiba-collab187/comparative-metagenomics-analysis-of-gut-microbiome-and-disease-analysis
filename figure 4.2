# =====================================================================
# HEATMAP FUNCTION
# =====================================================================

def generate_heatmap(
    matrix,
    filename,
    title,
    x_label
):

    plot_data = matrix.T

    n_taxa = plot_data.shape[1]

    # ---------------------------------------------------------------
    # VERY LARGE CANVAS
    #
    # 30-pt microbial names require substantially more width.
    # ---------------------------------------------------------------

    fig_width = max(
        30,
        min(
            55,
            n_taxa * 1.25
        )
    )

    fig_height = 12

    fig, ax = plt.subplots(
        figsize=(
            fig_width,
            fig_height
        )
    )

    # ---------------------------------------------------------------
    # LFC COLOUR SCALE
    # ---------------------------------------------------------------

    im = ax.imshow(
        plot_data.values,
        aspect="auto",
        cmap="RdBu_r",
        vmin=-MAX_LFC,
        vmax=MAX_LFC,
        interpolation="nearest"
    )

    # ---------------------------------------------------------------
    # DISEASE LABELS
    # 18 PT BOLD
    # ---------------------------------------------------------------

    ax.set_yticks(
        np.arange(10)
    )

    ax.set_yticklabels(
        [
            DISPLAY[d]
            for d in DISEASES
        ],
        fontsize=18,
        fontweight="bold"
    )

    # ---------------------------------------------------------------
    # MICROBIAL SPECIES
    #
    # 30 PT + BOLD
    # ---------------------------------------------------------------

    ax.set_xticks(
        np.arange(n_taxa)
    )

    ax.set_xticklabels(
        plot_data.columns.astype(str),
        rotation=65,
        ha="right",
        fontsize=30,
        fontweight="bold"
    )

    # ---------------------------------------------------------------
    # X AXIS LABEL
    # ---------------------------------------------------------------

    ax.set_xlabel(
        x_label,
        fontsize=20,
        fontweight="bold",
        labelpad=25
    )

    # ---------------------------------------------------------------
    # Y AXIS LABEL
    # ---------------------------------------------------------------

    ax.set_ylabel(
        "Disease",
        fontsize=20,
        fontweight="bold",
        labelpad=20
    )

    # ---------------------------------------------------------------
    # TITLE
    # ---------------------------------------------------------------

    ax.set_title(
        title,
        fontsize=23,
        fontweight="bold",
        pad=28
    )

    # ---------------------------------------------------------------
    # WHITE CELL BORDERS
    # ---------------------------------------------------------------

    ax.set_xticks(
        np.arange(
            -0.5,
            n_taxa,
            1
        ),
        minor=True
    )

    ax.set_yticks(
        np.arange(
            -0.5,
            10,
            1
        ),
        minor=True
    )

    ax.grid(
        which="minor",
        color="white",
        linewidth=0.7,
        alpha=0.7
    )

    ax.tick_params(
        which="minor",
        bottom=False,
        left=False
    )

    # ---------------------------------------------------------------
    # COLORBAR
    # ---------------------------------------------------------------

    cbar = fig.colorbar(
        im,
        ax=ax,
        fraction=0.025,
        pad=0.025
    )

    cbar.set_label(
        "log2 fold change",
        fontsize=18,
        fontweight="bold"
    )

    cbar.ax.tick_params(
        labelsize=14
    )

    # ---------------------------------------------------------------
    # LARGE BOTTOM SPACE FOR 30-PT LABELS
    # ---------------------------------------------------------------

    plt.subplots_adjust(
        left=0.15,
        right=0.96,
        top=0.87,
        bottom=0.48
    )

    # ---------------------------------------------------------------
    # SAVE SVG
    # ---------------------------------------------------------------

    output_path = (
        OUT_DIR /
        filename
    )

    fig.savefig(
        output_path,
        format="svg",
        bbox_inches="tight"
    )

    plt.close(fig)

    print(
        f"SAVED: {output_path}"
    )


