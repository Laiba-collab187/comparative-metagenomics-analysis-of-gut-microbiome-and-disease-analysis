def shared_pair_data(d1, d2):

    case_shared = sorted(
        set(top100[d1]["case"])
        & set(top100[d2]["case"]),
        key=lambda x: (
            rank[d1]["case"].get(x, 999),
            rank[d2]["case"].get(x, 999)
        )
    )

    control_shared = sorted(
        set(top100[d1]["control"])
        & set(top100[d2]["control"]),
        key=lambda x: (
            rank[d1]["control"].get(x, 999),
            rank[d2]["control"].get(x, 999)
        )
    )

    return case_shared, control_shared


