# =====================================================================
# ROBUST LFC MATRIX ORIENTATION
# =====================================================================

DISEASES = list(
    DISPLAY.keys()
)


def prepare_lfc(
    df,
    expected_taxa,
    label
):

    disease_columns = [
        d for d in DISEASES
        if d in df.columns
    ]

    if len(disease_columns) == 10:

        result = df[
            disease_columns
        ].copy()

        result.columns = DISEASES

    else:

        index_values = [
            str(x).strip()
            for x in df.index
        ]

        if not all(
            d in index_values
            for d in DISEASES
        ):

            raise ValueError(
                f"{label}: cannot identify all 10 diseases."
            )

        result = df.loc[
            DISEASES
        ].copy()

        result = result.T

        result.columns = DISEASES

    result = result.apply(
        pd.to_numeric,
        errors="coerce"
    )

    result = result.reindex(
        columns=DISEASES
    )

    if result.shape != (
        expected_taxa,
        10
    ):

        raise ValueError(
            f"{label}: expected "
            f"{expected_taxa} × 10, "
            f"found {result.shape}"
        )

    return result


