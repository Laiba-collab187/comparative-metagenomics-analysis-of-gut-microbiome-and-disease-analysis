# =====================================================================
# TOP-PAIR OVERLAP FUNCTION
# =====================================================================

def pair_overlap(
    disease_a,
    disease_b
):

    case_a = set(
        top100_cache[
            (disease_a, "case")
        ]
    )

    case_b = set(
        top100_cache[
            (disease_b, "case")
        ]
    )

    control_a = set(
        top100_cache[
            (disease_a, "control")
        ]
    )

    control_b = set(
        top100_cache[
            (disease_b, "control")
        ]
    )

    case_shared = sorted(
        case_a.intersection(
            case_b
        )
    )

    control_shared = sorted(
        control_a.intersection(
            control_b
        )
    )

    return (
        case_shared,
        control_shared
    )


