def find_top100_file(disease, direction):

    if direction == "case":
        pattern = (
            f"{disease}_TOP100_DISEASE_ENRICHED_CORRECTED.csv"
        )
    else:
        pattern = (
            f"{disease}_TOP100_HEALTHY_ENRICHED_CORRECTED.csv"
        )

    exact = os.path.join(TOP100_DIR, pattern)

    if os.path.exists(exact):
        return exact

    matches = glob.glob(
        f"/content/**/{pattern}",
        recursive=True
    )

    if not matches:
        raise FileNotFoundError(
            f"Could not find Top-100 {direction} file for "
            f"{disease}: {pattern}"
        )

    return matches[0]


# ============================================================
# 6. ROBUST TAXON COLUMN IDENTIFICATION
# ============================================================

def identify_taxon_column(df):

    preferred = [
        "taxon",
        "Taxon",
        "species",
        "Species",
        "microbe",
        "Microbe",
        "feature",
        "Feature",
        "name",
        "Name"
    ]

    for c in preferred:
        if c in df.columns:
            return c

    # Look for columns containing likely taxonomic names
    for c in df.columns:

        cl = str(c).lower()

        if any(
            word in cl
            for word in [
                "taxon",
                "species",
                "microbe",
                "feature",
                "organism"
            ]
        ):
            return c

    # Last resort:
    # choose the first non-numeric column
    for c in df.columns:

        if not pd.api.types.is_numeric_dtype(df[c]):
            return c

    raise ValueError(
        "Could not identify taxon/species column."
    )


