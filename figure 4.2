def find_species_column(df):

    candidates = [
        "microbe", "Microbe",
        "species", "Species",
        "taxon", "Taxon",
        "name", "Name",
        "feature", "Feature"
    ]

    for c in candidates:
        if c in df.columns:
            return c

    for c in df.columns:
        if df[c].dtype == object:
            return c

    raise ValueError(
        f"Could not identify species column. Columns={list(df.columns)}"
    )


def load_top100(disease, direction):

    if direction == "case":
        filename = (
            f"{disease}_TOP100_DISEASE_ENRICHED_CORRECTED.csv"
        )
    else:
        filename = (
            f"{disease}_TOP100_HEALTHY_ENRICHED_CORRECTED.csv"
        )

    path = TOP100_DIR / filename

    if not path.exists():
        raise FileNotFoundError(
            f"\nMissing corrected TOP-100 file:\n{path}"
        )

    df = pd.read_csv(path)

    species_col = find_species_column(df)

    df["species"] = (
        df[species_col]
        .astype(str)
        .str.strip()
    )

    df = df[
        (df["species"] != "") &
        (df["species"].str.lower() != "nan")
    ].copy()

    # The files are already the corrected top-100 sets.
    df = df.head(100).copy()

    if len(df) != 100:
        raise ValueError(
            f"{disease} {direction}: expected 100 taxa, "
            f"found {len(df)}"
        )

    # Rank according to validated top-100 ordering
    df["rank"] = np.arange(1, 101)

    return df[["species", "rank"]]


