# =====================================================================
# 5. FIND TOP-100 FILE
# =====================================================================

def find_top100_file(
    disease,
    group
):

    if group == "case":

        keyword = "DISEASE_ENRICHED"

    elif group == "control":

        keyword = "HEALTHY_ENRICHED"

    else:

        raise ValueError(
            "group must be case or control"
        )

    exact = TOP100_DIR / (
        f"{disease}_TOP100_"
        f"{keyword}_CORRECTED.csv"
    )

    if exact.exists():

        return exact

    candidates = list(
        TOP100_DIR.glob(
            f"{disease}_TOP100_*CORRECTED.csv"
        )
    )

    candidates = [
        p
        for p in candidates
        if keyword.lower() in p.name.lower()
    ]

    if len(candidates) == 1:

        return candidates[0]

    if len(candidates) == 0:

        raise FileNotFoundError(
            f"\nNo corrected {group} Top-100 file found for "
            f"{disease}."
        )

    raise ValueError(
        f"\nMultiple corrected files found for "
        f"{disease} / {group}:\n"
        + "\n".join(
            str(x)
            for x in candidates
        )
    )


# =====================================================================
# 6. IDENTIFY TAXON COLUMN
# =====================================================================

def identify_taxon_column(
    df
):

    preferred = [
        "name",
        "taxon",
        "Taxon",
        "species",
        "Species",
        "microbe",
        "Microbe",
        "feature",
        "Feature",
        "microbial_species",
        "Microbial_species"
    ]

    for col in preferred:

        if col in df.columns:

            return col

    for col in df.columns:

        if not pd.api.types.is_numeric_dtype(
            df[col]
        ):

            return col

    raise ValueError(
        "Could not identify microbial species column.\n"
        f"Columns: {list(df.columns)}"
    )


# =====================================================================
# 7. LOAD TOP-100 SIGNATURE
# =====================================================================

signature_cache = {}


def load_signature(
    disease,
    group
):

    key = (
        disease,
        group
    )

    if key in signature_cache:

        return signature_cache[key]

    filepath = find_top100_file(
        disease,
        group
    )

    df = pd.read_csv(
        filepath
    )

    taxon_col = identify_taxon_column(
        df
    )

    taxa = (
        df[taxon_col]
        .astype(str)
        .str.strip()
    )

    taxa = taxa[
        (taxa != "") &
        (taxa.str.lower() != "nan")
    ]

    taxa = list(
        dict.fromkeys(
            taxa.tolist()
        )
    )

    if len(taxa) != 100:

        raise ValueError(
            f"\n{disease} / {group}\n"
            f"Expected 100 taxa.\n"
            f"Found {len(taxa)}.\n"
            f"File: {filepath}"
        )

    signature_cache[key] = taxa

    return taxa


