# =====================================================================
# 21. RECURRENT LFC HEATMAP
# =====================================================================
#
# IMPORTANT VISUAL CHANGES REQUESTED:
#
#   - 27 pt BOLD microbial names
#   - labels extremely close to x-axis
#   - black boundaries around every microbial block
#   - small black connector/tick immediately beneath each label
#   - clear individual microbial blocks
#   - disease labels in bold
#   - diverging LFC colour scale
#
# =====================================================================

def make_recurrent_heatmap(
    matrix,
    filename,
    title,
    panel,
    part_number,
    total_parts,
    group
):

    # ---------------------------------------------------------------
    # Convert to numeric matrix
    # ---------------------------------------------------------------

    matrix = matrix.copy()

    matrix = matrix.apply(
        pd.to_numeric,
        errors="coerce"
    )

    # ---------------------------------------------------------------
    # Split already supplied matrix into this part
    # ---------------------------------------------------------------

    n_total = len(
        matrix
    )

    split_size = int(
        np.ceil(
            n_total / total_parts
        )
    )

    start = (
        part_number - 1
    ) * split_size

    end = min(
        start + split_size,
        n_total
    )

    sub = matrix.iloc[
        start:end
    ].copy()

    if len(sub) == 0:

        raise ValueError(
            f"No taxa available for "
            f"{filename}"
        )

    # ---------------------------------------------------------------
    # Remove all-NaN rows
    # ---------------------------------------------------------------

    sub = sub.dropna(
        how="all"
    )

    taxa = [
        str(x)
        for x in sub.index
    ]

    values = sub.values.astype(
        float
    )

    n_species = len(
        taxa
    )

    n_diseases = len(
        sub.columns
    )

    # ---------------------------------------------------------------
    # Figure size
    # ---------------------------------------------------------------

    fig_width = max(
        18,
        n_species * 0.72
    )

    fig_height = 10.5

    fig, ax = plt.subplots(
        figsize=(
            fig_width,
            fig_height
        )
    )

    # ---------------------------------------------------------------
    # Symmetric colour range based on actual LFC data
    # ---------------------------------------------------------------

    finite_values = values[
        np.isfinite(values)
    ]

    if len(finite_values) == 0:

        raise ValueError(
            f"No finite LFC values in {filename}"
        )

    vmax = np.nanmax(
        np.abs(
            finite_values
        )
    )

    if vmax == 0:

        vmax = 1

    # ---------------------------------------------------------------
    # HEATMAP
    # ---------------------------------------------------------------

    image = ax.imshow(
        values.T,
        aspect="auto",
        cmap="RdBu_r",
        vmin=-vmax,
        vmax=vmax,
        interpolation="nearest"
    )

    # ---------------------------------------------------------------
    # X AXIS = MICROBES
    # ---------------------------------------------------------------

    ax.set_xticks(
        np.arange(
            n_species
        )
    )

    ax.set_xticklabels(
        taxa,
        fontsize=27,
        fontweight="bold",
        rotation=90,
        ha="center",
        va="top"
    )

    # ===============================================================
    # VERY IMPORTANT:
    # PUT MICROBE NAMES DIRECTLY AGAINST THE X-AXIS
    # ===============================================================

    ax.tick_params(
        axis="x",
        which="major",
        pad=-2,
        length=5,
        width=1.5
    )

    # ---------------------------------------------------------------
    # X-axis disease rows
    # ---------------------------------------------------------------

    ax.set_yticks(
        np.arange(
            n_diseases
        )
    )

    ax.set_yticklabels(
        [
            DISPLAY[d]
            for d in sub.columns
        ],
        fontsize=15,
        fontweight="bold"
    )

    # ---------------------------------------------------------------
    # BLACK BLOCK BOUNDARIES
    #
    # Every microbial column gets a black boundary.
    # ---------------------------------------------------------------

    ax.set_xticks(
        np.arange(
            -0.5,
            n_species,
            1
        ),
        minor=True
    )

    ax.set_yticks(
        np.arange(
            -0.5,
            n_diseases,
            1
        ),
        minor=True
    )

    ax.grid(
        which="minor",
        color="black",
        linewidth=0.8
    )

    ax.tick_params(
        which="minor",
        bottom=False,
        left=False
    )

    # ---------------------------------------------------------------
    # SMALL BLACK CONNECTOR/TICK LINE BELOW EACH MICROBE NAME
    #
    # This creates the short visible line connecting the microbial
    # label to its x-axis position, as requested from the reference
    # style.
    # ---------------------------------------------------------------

    for xpos in range(
        n_species
    ):

        ax.plot(
            [
                xpos,
                xpos
            ],
            [
                -0.02,
                -0.07
            ],
            transform=ax.get_xaxis_transform(),
            color="black",
            linewidth=1.2,
            clip_on=False
        )

    # ---------------------------------------------------------------
    # PANEL LABEL
    # ---------------------------------------------------------------

    ax.text(
        -0.025,
        1.025,
        panel,
        transform=ax.transAxes,
        fontsize=24,
        fontweight="bold",
        ha="left",
        va="bottom"
    )

    # ---------------------------------------------------------------
    # PART LABEL
    # ---------------------------------------------------------------

    ax.text(
        1.0,
        1.025,
        f"Part {part_number}/{total_parts}",
        transform=ax.transAxes,
        fontsize=15,
        fontweight="bold",
        ha="right",
        va="bottom"
    )

    # ---------------------------------------------------------------
    # TITLE
    # ---------------------------------------------------------------

    ax.set_title(
        title,
        fontsize=21,
        fontweight="bold",
        pad=16
    )

    # ---------------------------------------------------------------
    # COLORBAR
    # ---------------------------------------------------------------

    cbar = fig.colorbar(
        image,
        ax=ax,
        fraction=0.025,
        pad=0.025
    )

    cbar.set_label(
        "log2 fold change",
        fontsize=16,
        fontweight="bold"
    )

    cbar.ax.tick_params(
        labelsize=13
    )

    # ---------------------------------------------------------------
    # BLACK OUTER BORDER
    # ---------------------------------------------------------------

    for spine in ax.spines.values():

        spine.set_color(
            "black"
        )

        spine.set_linewidth(
            1.4
        )

    # ===============================================================
    # IMPORTANT LAYOUT:
    #
    # bottom margin deliberately reduced so the microbial names
    # remain immediately below the x-axis rather than far away.
    # ===============================================================

    plt.subplots_adjust(
        left=0.18,
        right=0.94,
        top=0.87,
        bottom=0.30
    )

    # ---------------------------------------------------------------
    # SAVE SVG
    # ---------------------------------------------------------------

    output = (
        OUT_DIR /
        filename
    )

    fig.savefig(
        output,
        format="svg",
        bbox_inches="tight",
        facecolor="white"
    )

    plt.close(
        fig
    )

    print(
        f"SAVED: {output}"
    )

    print(
        f"    Taxa in part: {n_species}"
    )


