# ======================================================================
# 2. LOAD NEW TOP-100 CASE / CONTROL SIGNATURES
# ======================================================================

def load_top100(disease, association):

    if association == "case":

        path = (
            TOP100_ROOT /
            f"{disease}_TOP100_DISEASE_ENRICHED_CORRECTED.csv"
        )

    else:

        path = (
            TOP100_ROOT /
            f"{disease}_TOP100_HEALTHY_ENRICHED_CORRECTED.csv"
        )

    if not path.exists():

        raise FileNotFoundError(
            f"\nNEW Top-100 file not found:\n{path}"
        )

    df = pd.read_csv(path)

    required = [
        "Rank",
        "microbe"
    ]

    missing = [
        c for c in required
        if c not in df.columns
    ]

    if missing:

        raise ValueError(
            f"{path}: missing {missing}"
        )

    if len(df) != 100:

        raise ValueError(
            f"{path}: expected 100 rows, found {len(df)}"
        )

    return df[
        [
            "Rank",
            "microbe"
        ]
    ].copy()


def add_new_ranks(
    shap_lfc,
    disease
):

    case = load_top100(
        disease,
        "case"
    )

    control = load_top100(
        disease,
        "control"
    )

    # --------------------------------------------------------------
    # Rename rank columns
    # --------------------------------------------------------------

    case = case.rename(
        columns={
            "Rank": "Case_Rank"
        }
    )

    control = control.rename(
        columns={
            "Rank": "Control_Rank"
        }
    )

    # --------------------------------------------------------------
    # Merge BOTH NEW rankings onto the SHAP features
    # --------------------------------------------------------------

    out = shap_lfc.merge(
        case,
        on="microbe",
        how="left"
    )

    out = out.merge(
        control,
        on="microbe",
        how="left"
    )

    return out


covid = add_new_ranks(
    covid,
    PAIR_A
)

