# ======================================================================
# FIGURE 4.1a / 4.1b
# SHAP VS LFC
# ======================================================================

def make_shap_lfc(
    df,
    disease,
    group,
    filename,
    panel
):

    if group == "case":

        shap_col = "Case_SHAP_Sum"
        subtitle = "Disease cases"

    else:

        shap_col = "Control_SHAP_Sum"
        subtitle = "Healthy controls"

    fig, ax = plt.subplots(
        figsize=(10.5, 8.5)
    )

    # --------------------------------------------------------------
    # Neutral
    # --------------------------------------------------------------

    neutral = df[
        df["Association"] == "Neutral"
    ]

    ax.scatter(
        neutral[shap_col],
        neutral["log2FoldChange"],
        s=90,
        c=NEUTRAL_COLOR,
        edgecolors="black",
        linewidths=0.7,
        alpha=0.75,
        zorder=2
    )

    # --------------------------------------------------------------
    # Case-associated
    # --------------------------------------------------------------

    case = df[
        df["Association"] == "Case-associated"
    ]

    ax.scatter(
        case[shap_col],
        case["log2FoldChange"],
        s=115,
        c=CASE_COLOR,
        edgecolors="black",
        linewidths=0.9,
        alpha=0.95,
        zorder=3
    )

    # --------------------------------------------------------------
    # Control-associated
    # --------------------------------------------------------------

    control = df[
        df["Association"] == "Control-associated"
    ]

    ax.scatter(
        control[shap_col],
        control["log2FoldChange"],
        s=115,
        c=CONTROL_COLOR,
        edgecolors="black",
        linewidths=0.9,
        alpha=0.95,
        zorder=3
    )

    # --------------------------------------------------------------
    # Reference zero lines
    # --------------------------------------------------------------

    ax.axhline(
        0,
        color="black",
        linestyle="--",
        linewidth=1.1,
        alpha=0.55
    )

    ax.axvline(
        0,
        color="black",
        linestyle="--",
        linewidth=1.1,
        alpha=0.55
    )

    # --------------------------------------------------------------
    # Label strongest SHAP features
    # --------------------------------------------------------------

    temp = df.copy()

    temp["abs_shap"] = (
        temp[shap_col]
        .abs()
    )

    strongest = (
        temp
        .sort_values(
            "abs_shap",
            ascending=False
        )
        .head(5)
    )

    for _, row in strongest.iterrows():

        ax.annotate(
            row["microbe"],
            (
                row[shap_col],
                row["log2FoldChange"]
            ),
            xytext=(7, 7),
            textcoords="offset points",
            fontsize=MICROBE_SIZE,
            fontweight="bold",
            ha="left",
            va="bottom",
            bbox=dict(
                boxstyle="round,pad=0.15",
                facecolor="white",
                edgecolor="none",
                alpha=0.80
            )
        )

    # --------------------------------------------------------------
    # Labels
    # --------------------------------------------------------------

    ax.set_xlabel(
        "Shapley value",
        fontsize=AXIS_LABEL_SIZE
    )

    ax.set_ylabel(
        "log2 fold change (LFC)",
        fontsize=AXIS_LABEL_SIZE
    )

    ax.set_title(
        f"{panel}  {disease} — {subtitle}",
        fontsize=TITLE_SIZE,
        fontweight="bold",
        pad=12
    )

    # --------------------------------------------------------------
    # Legend
    # --------------------------------------------------------------

    handles = [

        Line2D(
            [0],
            [0],
            marker="o",
            color="none",
            markerfacecolor=CASE_COLOR,
            markeredgecolor="black",
            markersize=10,
            label="Case-associated"
        ),

        Line2D(
            [0],
            [0],
            marker="o",
            color="none",
            markerfacecolor=CONTROL_COLOR,
            markeredgecolor="black",
            markersize=10,
            label="Control-associated"
        ),

        Line2D(
            [0],
            [0],
            marker="o",
            color="none",
            markerfacecolor=NEUTRAL_COLOR,
            markeredgecolor="black",
            markersize=10,
            label="Neutral"
        )
    ]

    ax.legend(
        handles=handles,
        fontsize=LEGEND_SIZE,
        frameon=False,
        loc="best"
    )

    ax.tick_params(
        axis="both",
        labelsize=TICK_SIZE,
        width=1.5,
        length=6
    )

    ax.grid(
        False
    )

    for spine in ax.spines.values():

        spine.set_linewidth(
            1.6
        )

    fig.tight_layout()

    output = (
        OUT_DIR /
        filename
    )

    fig.savefig(
        output,
        format="svg",
        bbox_inches="tight"
    )

    plt.close(
        fig
    )

    print(
        "SAVED:",
        output
    )


