# ======================================================================
# FIGURE 4.1c — SHARED MICROBES
# ======================================================================

def make_rank_plot(
    disease_a,
    disease_b,
    group,
    filename,
    panel
):

    a = load_top100(
        disease_a,
        group
    )

    b = load_top100(
        disease_b,
        group
    )

    shared = (
        set(a["microbe"])
        &
        set(b["microbe"])
    )

    if group == "case":

        color = CASE_COLOR

        ylabel = (
            "Rank among case-associated microbes"
        )

    else:

        color = CONTROL_COLOR

        ylabel = (
            "Rank among control-associated microbes"
        )

    a = a[
        a["microbe"].isin(shared)
    ].copy()

    b = b[
        b["microbe"].isin(shared)
    ].copy()

    a = a.rename(
        columns={
            "Rank": "Rank_A"
        }
    )

    b = b.rename(
        columns={
            "Rank": "Rank_B"
        }
    )

    merged = a.merge(
        b,
        on="microbe"
    )

    merged["Mean_Rank"] = (
        merged["Rank_A"]
        +
        merged["Rank_B"]
    ) / 2

    merged = (
        merged
        .sort_values(
            "Mean_Rank"
        )
        .reset_index(
            drop=True
        )
    )

    fig, ax = plt.subplots(
        figsize=(16, 9)
    )

    x = np.arange(
        len(merged)
    )

    # --------------------------------------------------------------
    # Light dotted vertical divisions
    # --------------------------------------------------------------

    for xpos in x:

        ax.axvline(
            xpos,
            color="black",
            linestyle=":",
            linewidth=0.65,
            alpha=0.30,
            zorder=0
        )

    # --------------------------------------------------------------
    # Connect rankings
    # --------------------------------------------------------------

    for i, row in merged.iterrows():

        ax.plot(
            [i, i],
            [
                row["Rank_A"],
                row["Rank_B"]
            ],
            color=color,
            linewidth=1.8,
            alpha=0.75,
            zorder=2
        )

    # --------------------------------------------------------------
    # Disease A
    # --------------------------------------------------------------

    ax.scatter(
        x,
        merged["Rank_A"],
        s=110,
        marker="o",
        c=color,
        edgecolors="black",
        linewidths=0.8,
        label=disease_a,
        zorder=4
    )

    # --------------------------------------------------------------
    # Disease B
    # --------------------------------------------------------------

    ax.scatter(
        x,
        merged["Rank_B"],
        s=110,
        marker="D",
        c=color,
        edgecolors="black",
        linewidths=0.8,
        label=disease_b,
        zorder=4
    )

    # --------------------------------------------------------------
    # Rank 1 at top
    # --------------------------------------------------------------

    ax.set_ylim(
        100.5,
        0.5
    )

    ax.set_ylabel(
        ylabel,
        fontsize=AXIS_LABEL_SIZE
    )

    ax.set_xlabel(
        "Shared microbial species",
        fontsize=AXIS_LABEL_SIZE
    )

    ax.set_title(
        f"{panel}  Shared {group}-associated microbes",
        fontsize=TITLE_SIZE,
        fontweight="bold",
        pad=12
    )

    # --------------------------------------------------------------
    # Microbial names CLOSE to x-axis
    # --------------------------------------------------------------

    ax.set_xticks(
        x
    )

    ax.set_xticklabels(
        merged["microbe"],
        rotation=90,
        ha="center",
        va="top",
        fontsize=16,
        fontweight="bold"
    )

    ax.tick_params(
        axis="x",
        pad=0,
        length=5,
        width=1.4
    )

    ax.tick_params(
        axis="y",
        labelsize=TICK_SIZE,
        width=1.5,
        length=6
    )

    ax.legend(
        fontsize=LEGEND_SIZE,
        frameon=False,
        loc="upper right"
    )

    for spine in ax.spines.values():

        spine.set_linewidth(
            1.6
        )

    ax.grid(
        False
    )

    # Very small bottom margin so names stay close
    fig.subplots_adjust(
        left=0.12,
        right=0.98,
        top=0.90,
        bottom=0.34
    )

    output = (
        OUT_DIR /
        filename
    )

    fig.savefig(
        output,
        format="svg",
        bbox_inches="tight"
    )

    plt.close(
        fig
    )

    print(
        "SAVED:",
        output
    )

    return merged


