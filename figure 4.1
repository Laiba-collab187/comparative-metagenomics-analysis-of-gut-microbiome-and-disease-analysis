# ======================================================================
# TOP-100 LOADER
# ======================================================================

def load_top100(
    disease,
    group
):

    if group == "case":

        filename = (
            f"{disease}_TOP100_DISEASE_ENRICHED_CORRECTED.csv"
        )

    else:

        filename = (
            f"{disease}_TOP100_HEALTHY_ENRICHED_CORRECTED.csv"
        )

    path = TOP100_DIR / filename

    if not path.exists():

        raise FileNotFoundError(
            f"\nTop-100 file missing:\n{path}"
        )

    df = pd.read_csv(
        path
    )

    if len(df) != 100:

        raise ValueError(
            f"{path}: expected 100 rows, "
            f"found {len(df)}"
        )

    return df[
        ["Rank", "microbe"]
    ].copy()


