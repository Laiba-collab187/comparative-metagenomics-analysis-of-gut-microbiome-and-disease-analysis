# ======================================================================
# 12. FINAL REPORT
# ======================================================================

print("\n" + "=" * 100)
print("FIGURE 4.1 FINAL INPUT QC")
print("=" * 100)

print(
    "\nSelected disease pair:"
)

print(
    "COVID19 × Dwarfism"
)

print(
    "\nCOVID19:"
)

print(
    f"  Complete SHAP-LFC points = "
