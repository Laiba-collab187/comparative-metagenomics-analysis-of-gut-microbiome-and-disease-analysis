from pathlib import Path
import pandas as pd
import numpy as np
import re

BASE = Path("/content")

SHAP_ROOT = (
    BASE /
    "FINAL_RF_SHAP_QUALIFIED_DISEASES"
)

OUT_DIR = (
    BASE /
    "FINAL_FIGURE_4_1_NEW_SHAP_PAIR_AUDIT"
)

OUT_DIR.mkdir(
    parents=True,
    exist_ok=True
)

DISEASES = [
    "COVID19",
    "Dwarfism"
]


# ======================================================================
# 1. LOAD ACTUAL NEW SHAP TABLES
# ======================================================================

print("=" * 100)
print("FIGURE 4.1 — COVID19 × DWARFISM FULL LFC INTEGRATION")
print("=" * 100)

shap_tables = {}

for disease in DISEASES:

    shap_file = (
        SHAP_ROOT /
        disease /
        f"{disease}_RF_SHAP_VALUES.csv"
    )

    if not shap_file.exists():

        raise FileNotFoundError(
            f"\nSHAP file not found:\n{shap_file}"
        )

    df = pd.read_csv(
        shap_file
    )

    metadata = {
        "name",
        "label",
        "condition"
    }

    microbial_cols = [
        c for c in df.columns
        if c not in metadata
    ]

    if len(microbial_cols) != 30:

        raise ValueError(
            f"{disease}: expected 30 SHAP microbial features, "
            f"found {len(microbial_cols)}"
        )

    # --------------------------------------------------------------
    # Signed SHAP sums
    # --------------------------------------------------------------

    case_df = df[
        df["label"] == 1
    ]

    control_df = df[
        df["label"] == 0
    ]

    case_sum = (
        case_df[microbial_cols]
        .sum(axis=0)
    )

    control_sum = (
        control_df[microbial_cols]
        .sum(axis=0)
    )

    result = pd.DataFrame({
        "microbe": microbial_cols,
        "Case_SHAP_Sum": [
            case_sum[x]
            for x in microbial_cols
        ],
        "Control_SHAP_Sum": [
            control_sum[x]
            for x in microbial_cols
        ]
    })

    result["Disease"] = disease

    shap_tables[disease] = result

    print(
        f"\n{disease}:"
    )

    print(
        f"  SHAP samples: {len(df)}"
    )

    print(
        f"  Case samples: {len(case_df)}"
    )

    print(
        f"  Healthy samples: {len(control_df)}"
    )

    print(
        f"  SHAP microbial features: {len(microbial_cols)}"
    )


# ======================================================================
# 2. SEARCH /content FOR FULL DESEQ2 FILES
#
# We deliberately do NOT assume a filename.
# ======================================================================

print("\n" + "=" * 100)
print("SEARCHING FOR NEW FULL DESEQ2 RESULTS")
print("=" * 100)

all_csvs = list(
    BASE.rglob("*.csv")
)

print(
    f"\nCSV files examined: {len(all_csvs)}"
)


# ======================================================================
# 3. NORMALIZE COLUMN NAMES
# ======================================================================

def norm(x):

    return (
        str(x)
        .strip()
        .lower()
        .replace(" ", "_")
        .replace("-", "_")
    )


# ======================================================================
# 4. IDENTIFY CANDIDATE FULL DESEQ2 FILES
# ======================================================================

candidate_files = {
    disease: []
    for disease in DISEASES
}


for path in all_csvs:

    name = path.name.lower()
    path_text = str(path).lower()

    # Must look like a DESeq2 result
    looks_deseq = (
        "deseq" in name
        or
        "deseq2" in name
    )

    if not looks_deseq:
        continue

    # Don't accidentally use the corrected Top100 files
    if "top100" in path_text:
        continue

    try:

        df = pd.read_csv(
            path,
            nrows=5
        )

    except Exception:

        continue

    cols = {
        norm(c)
        for c in df.columns
    }

    # Required DESeq2 LFC field
    if "log2foldchange" not in cols:
        continue

    # Identify disease
    for disease in DISEASES:

        disease_variants = {
            disease.lower(),
            disease.lower().replace("_", ""),
            disease.lower().replace("_", " ")
        }

        if any(
            v in path_text
            for v in disease_variants
        ):

            candidate_files[disease].append(
                path
            )


# ======================================================================
# 5. DISPLAY CANDIDATES
# ======================================================================

for disease in DISEASES:

    print(
        f"\n{disease} candidate DESeq2 files:"
    )

    if len(candidate_files[disease]) == 0:

        print(
            "   NONE FOUND"
        )

    else:

        for p in candidate_files[disease]:

            print(
                "   ",
                p
            )


# ======================================================================
# 6. AUTOMATICALLY SELECT THE MOST LIKELY FULL DESEQ2 FILE
# ======================================================================

def score_deseq_file(path, disease):

    text = str(path).lower()

    score = 0

    # Disease name
    if disease.lower() in text:
        score += 20

    # Explicit full-results naming
    if "full" in text:
        score += 20

    if "results" in text:
        score += 10

    if "deseq2" in text:
        score += 10

    # Penalize Top100 / directional subsets
    if "top100" in text:
        score -= 100

    if "upregulated" in text:
        score -= 30

    if "downregulated" in text:
        score -= 30

    if "significant" in text:
        score -= 20

    return score


selected_deseq = {}

for disease in DISEASES:

    candidates = candidate_files[disease]

    if len(candidates) == 0:

        raise FileNotFoundError(
            f"\nNo full DESeq2 candidate found for {disease}."
        )

    ranked = sorted(
        candidates,
        key=lambda p: score_deseq_file(
            p,
            disease
        ),
        reverse=True
    )

    selected_deseq[disease] = ranked[0]

    print(
        f"\nSELECTED {disease} DESeq2:"
    )

    print(
        ranked[0]
    )


# ======================================================================
# 7. LOAD SELECTED FULL DESEQ2 RESULTS
# ======================================================================

deseq_tables = {}

for disease in DISEASES:

    path = selected_deseq[disease]

    df = pd.read_csv(
        path
    )

    # Locate columns
    col_map = {
        norm(c): c
        for c in df.columns
    }

    if "log2foldchange" not in col_map:

        raise ValueError(
            f"{path} has no log2FoldChange column."
        )

    lfc_col = col_map[
        "log2foldchange"
    ]

    # Find microbe/species column
    microbe_col = None

    for candidate in [
        "microbe",
        "species",
        "taxon",
        "feature",
        "name"
    ]:

        if candidate in col_map:

            microbe_col = col_map[
                candidate
            ]

            break

    if microbe_col is None:

        # Try common first-column structures
        for c in df.columns:

            clean = norm(c)

            if (
                "microbe" in clean
                or
                "species" in clean
                or
                "taxon" in clean
                or
                "feature" in clean
            ):

                microbe_col = c
                break

    if microbe_col is None:

        raise ValueError(
            f"\nCould not identify microbial/species column "
            f"in:\n{path}\n"
            f"Columns:\n{list(df.columns)}"
        )

    lfc = df[
        [
            microbe_col,
            lfc_col
        ]
    ].copy()

    lfc.columns = [
        "microbe",
        "log2FoldChange"
    ]

    lfc["microbe"] = (
        lfc["microbe"]
        .astype(str)
        .str.strip()
    )

    lfc["log2FoldChange"] = pd.to_numeric(
        lfc["log2FoldChange"],
        errors="coerce"
    )

    # Remove duplicate microbial names
    lfc = (
        lfc
        .drop_duplicates(
            subset="microbe",
            keep="first"
        )
    )

    deseq_tables[disease] = lfc

    print(
        f"\n{disease} DESeq2:"
    )

    print(
        f"  File: {path}"
    )

    print(
        f"  Rows: {len(df)}"
    )

    print(
        f"  Unique microbes: {len(lfc)}"
    )

    print(
        f"  LFC column: {lfc_col}"
    )

    print(
        f"  Microbe column: {microbe_col}"
    )


# ======================================================================
# 8. MERGE FULL DESEQ2 LFC WITH SHAP
# ======================================================================

integrated = {}

for disease in DISEASES:

    merged = shap_tables[disease].merge(
        deseq_tables[disease],
        on="microbe",
        how="left"
    )

    integrated[disease] = merged

    matched = (
        merged["log2FoldChange"]
        .notna()
        .sum()
    )

    total = len(merged)

    print("\n" + "-" * 80)

    print(
        f"{disease}:"
    )

    print(
        f"  SHAP features: {total}"
    )

    print(
        f"  Full-DESeq2 LFC matched: {matched}"
    )

    print(
        f"  Missing LFC: {total - matched}"
    )

    # --------------------------------------------------------------
    # Save
    # --------------------------------------------------------------

    merged.to_csv(
        OUT_DIR /
        f"{disease}_SHAP_FULL_DESEQ2_LFC.csv",
        index=False
    )


# ======================================================================
# 9. STRICT QC
# ======================================================================

print("\n" + "=" * 100)
print("STRICT SHAP–LFC QC")
print("=" * 100)

for disease in DISEASES:

    df = integrated[disease]

    missing = df[
        df["log2FoldChange"].isna()
    ]

    if len(missing) > 0:

        print(
            f"\nWARNING — {disease}: "
            f"{len(missing)} SHAP features still lack LFC."
        )

        display(
            missing[
                [
                    "microbe",
                    "Case_SHAP_Sum",
                    "Control_SHAP_Sum"
                ]
            ]
        )

    else:

        print(
            f"\nPASS — {disease}: "
            f"ALL {len(df)} SHAP FEATURES HAVE NEW FULL-DESEQ2 LFC"
        )


# ======================================================================
# 10. FINAL DATASET FOR FIGURE 4.1
# ======================================================================

covid19_fig41 = integrated[
    "COVID19"
].copy()

dwarfism_fig41 = integrated[
    "Dwarfism"
].copy()


# Require complete SHAP + LFC information
covid19_complete = covid19_fig41[
    covid19_fig41["log2FoldChange"].notna()
].copy()

dwarfism_complete = dwarfism_fig41[
    dwarfism_fig41["log2FoldChange"].notna()
