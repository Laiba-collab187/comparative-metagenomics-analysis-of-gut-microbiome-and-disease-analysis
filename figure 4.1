# ======================================================================
# PATHS
# ======================================================================

BASE = Path("/content")

INPUT_DIR = (
    BASE /
    "FINAL_FIGURE_4_1_NEW_SHAP_PAIR_AUDIT"
)

TOP100_DIR = (
    BASE /
    "CORRECTED_DESEQ2_TOP100_REFERENCE_ALIGNED"
