# ======================================================================
# FIND VALIDATED FILE ROBUSTLY
#
# This avoids the previous capitalization/path mistake.
# ======================================================================

def find_validated_file(disease):

    disease_upper = disease.upper()

    candidates = []

    for p in INPUT_DIR.glob("*.csv"):

        name_upper = p.name.upper()

        if (
            f"FIGURE_4_1_{disease_upper}_FINAL_REFERENCE_ALIGNED_DATA.CSV"
            == name_upper
        ):
            candidates.append(p)

    if len(candidates) == 1:
        return candidates[0]

    # More flexible fallback
    for p in INPUT_DIR.glob("*.csv"):

        name_upper = p.name.upper()

        if (
            "FIGURE_4_1" in name_upper
            and disease_upper in name_upper
            and "FINAL_REFERENCE_ALIGNED_DATA" in name_upper
        ):
            return p

    raise FileNotFoundError(
        f"\nCould not find validated Figure 4.1 file for {disease}.\n"
        f"\nFiles currently present in:\n{INPUT_DIR}\n\n"
        + "\n".join(
            str(x.name)
            for x in INPUT_DIR.glob("*")
        )
    )


# ======================================================================
