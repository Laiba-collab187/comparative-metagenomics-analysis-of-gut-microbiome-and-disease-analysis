# ======================================================================
# 3. ASSIGN REFERENCE-STYLE ASSOCIATION
#
# A microbe can be:
#   Case-associated
#   Control-associated
#   Neutral
#
# We do NOT infer this from SHAP sign.
# We use the NEW differential-abundance ranking.
# ======================================================================

def assign_association(df):

    def classify(row):

        case_rank = row["Case_Rank"]
        control_rank = row["Control_Rank"]

        if pd.notna(case_rank):

            return "Case-associated"

        if pd.notna(control_rank):

            return "Control-associated"

        return "Neutral"

    df["Association"] = df.apply(
        classify,
        axis=1
    )

    return df


