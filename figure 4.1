def load_integrated(disease):

    path = (
        SHAP_AUDIT /
        f"{disease}_SHAP_FULL_DESEQ2_LFC.csv"
    )

    if not path.exists():

        raise FileNotFoundError(
            f"\nIntegrated SHAP/LFC file not found:\n{path}"
        )

    df = pd.read_csv(path)

    required = [
        "microbe",
        "Case_SHAP_Sum",
        "Control_SHAP_Sum",
        "log2FoldChange"
    ]

    missing = [
        c for c in required
        if c not in df.columns
    ]

    if missing:

        raise ValueError(
            f"{disease}: missing columns {missing}"
        )

    return df


covid = load_integrated(PAIR_A)
