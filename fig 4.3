    "\n10 diseases: VERIFIED"
)

print(
    "45 disease pairs: VERIFIED"
)

print(
    "No self-pairs: VERIFIED"
)

print(
    "No duplicate pairs: VERIFIED"
)

print(
    "Case + control = total: VERIFIED"
)


