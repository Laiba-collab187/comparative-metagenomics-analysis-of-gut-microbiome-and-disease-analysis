# ======================================================================
# FIGURE 4.3 — REFERENCE-ALIGNED COMBINED DISEASE SIMILARITY NETWORK
#
# REFERENCE FIGURE 5 LOGIC:
#
#   Node = disease
#
#   Edge = similarity between two diseases
#
#   SALMON portion = overlap of top-100 CASE-associated microbes
#
#   BLUE portion = overlap of top-100 CONTROL-associated microbes
#
#   TOTAL EDGE WEIGHT =
#       case-associated overlap
#       +
#       control-associated overlap
#
#   EDGE LABEL =
#       total overlapped microbes
#
# IMPORTANT:
#   Uses ONLY the NEW corrected 45-pair overlap results.
#
# NO OLD THESIS RESULTS
# NO SHAP RERUN
# NO ML RERUN
# NO DESeq2 RERUN
# ======================================================================

from pathlib import Path
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
import zipfile


# ======================================================================
# PATHS
# ======================================================================

BASE = Path("/content")

PAIR_FILE = (
    BASE /
    "FINAL_CORRECTED_REFERENCE_ALIGNED_DISEASE_PAIR_OVERLAP" /
    "ALL_45_CORRECTED_DISEASE_PAIRS_OVERLAP.csv"
)

OUT_DIR = (
    BASE /
    "FINAL_THESIS_FIGURE_4_3_CORRECT_NETWORK_SVG"
)

OUT_DIR.mkdir(
    parents=True,
    exist_ok=True
)

OUTPUT_SVG = (
    OUT_DIR /
    "Figure_4_3_Disease_Similarity_Network.svg"
)

OUTPUT_CSV = (
    OUT_DIR /
    "Figure_4_3_NETWORK_DATA_USED.csv"
)

OUTPUT_ZIP = (
    BASE /
    "FINAL_THESIS_FIGURE_4_3_CORRECT_NETWORK_SVG.zip"
)


# ======================================================================
# LOAD NEW 45-PAIR RESULTS
# ======================================================================

print("=" * 100)
print("FIGURE 4.3 — NEW COMBINED DISEASE SIMILARITY NETWORK")
print("=" * 100)

if not PAIR_FILE.exists():

    raise FileNotFoundError(
        f"\nNEW corrected 45-pair file not found:\n{PAIR_FILE}"
    )

df = pd.read_csv(
    PAIR_FILE
)

print(
    "\nInput:"
)

print(
    PAIR_FILE
)

print(
    "\nShape:",
    df.shape
)


# ======================================================================
# REQUIRED COLUMNS
# ======================================================================

required_columns = [
    "Disease_A",
    "Disease_B",
    "Disease_enriched_overlap_n",
    "Healthy_enriched_overlap_n",
    "Total_directional_overlap_n"
]

missing = [
    c for c in required_columns
    if c not in df.columns
]

if missing:

    raise ValueError(
        f"\nMissing required columns:\n{missing}"
    )


# ======================================================================
# STRICT NEW-RESULT QC
# ======================================================================

if len(df) != 45:

    raise ValueError(
        f"Expected 45 disease pairs, found {len(df)}"
    )


# Check total = case + control
total_check = (
    df["Disease_enriched_overlap_n"]
    +
    df["Healthy_enriched_overlap_n"]
)

if not np.array_equal(
    total_check.astype(int),
    df["Total_directional_overlap_n"].astype(int)
):

    raise ValueError(
