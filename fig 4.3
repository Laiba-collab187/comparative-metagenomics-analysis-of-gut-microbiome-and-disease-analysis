# ======================================================================
# COLORS — REFERENCE FIGURE LOGIC
#
# Salmon = case-associated overlap
# Blue   = control-associated overlap
# ======================================================================

CASE_COLOR = "#E88982"
CONTROL_COLOR = "#4C78A8"

NODE_FACE = "white"
NODE_EDGE = "black"


# ======================================================================
# FONT / SVG SETTINGS
# ======================================================================

plt.rcParams.update({

    "font.family":
        "DejaVu Sans",

    # Keep text as text in SVG
    "svg.fonttype":
        "none",

    "figure.dpi":
        300,

    "axes.linewidth":
        1.5
})


# ======================================================================
# CIRCULAR NODE POSITIONS
#
# We use a clean circular arrangement like the reference network,
# rather than making node size represent another biological variable.
# ======================================================================

# Put diseases in a stable order.
# This makes the figure reproducible.

diseases_order = [
    "Autism",
    "Colorectal_Neoplasm",
    "COVID19",
    "Dwarfism",
    "Fatigue",
    "Fibromyalgia",
    "IBS",
    "Neuroblastoma",
    "Obesity",
    "Ulcerative_Colitis"
]

# Make sure all are present
if set(diseases_order) != set(diseases):

    raise ValueError(
        "\nDisease list mismatch."
    )


n = len(
    diseases_order
)

# Start at top
angles = (
    np.pi / 2
    -
    np.arange(n)
    *
    2 * np.pi / n
)

radius = 1.0

positions = {}

for disease, angle in zip(
    diseases_order,
    angles
):

    positions[disease] = (
        radius * np.cos(angle),
        radius * np.sin(angle)
    )


# ======================================================================
# EDGE WIDTH SCALING
#
# Width represents TOTAL overlap.
# ======================================================================

min_total = network[
    "Total_overlap"
].min()

max_total = network[
    "Total_overlap"
].max()


def total_width(total):

    if max_total == min_total:

        return 3.0

    return (
        1.5
        +
        (
            total - min_total
        )
        /
        (
            max_total - min_total
        )
        *
        7.0
    )


# ======================================================================
# CREATE FIGURE
# ======================================================================

fig, ax = plt.subplots(
    figsize=(15, 15)
)

ax.set_aspect(
    "equal"
)

ax.axis(
    "off"
)


# ======================================================================
# DRAW COMBINED EDGES
#
# THIS IS THE IMPORTANT CORRECTION.
#
# Each disease pair gets ONE total-width edge.
#
# That edge is divided proportionally into:
#
#     SALMON = CASE OVERLAP
#     BLUE   = CONTROL OVERLAP
#
# Example:
#
#     Case = 17
#     Control = 24
#     Total = 41
#
# Salmon portion = 17/41
# Blue portion   = 24/41
# ======================================================================

for _, row in network.iterrows():

    disease_a = row["Disease_A"]
    disease_b = row["Disease_B"]

    case_n = row["Case_overlap"]
    control_n = row["Control_overlap"]
    total_n = row["Total_overlap"]

    x1, y1 = positions[
        disease_a
    ]

    x2, y2 = positions[
        disease_b
    ]

    # --------------------------------------------------------------
    # TOTAL EDGE WIDTH
    # --------------------------------------------------------------

    width = total_width(
        total_n
    )

    # --------------------------------------------------------------
    # Split total edge width proportionally
    # --------------------------------------------------------------

    if total_n > 0:

        case_width = (
            width
            *
            case_n
            /
            total_n
        )

        control_width = (
            width
            *
            control_n
            /
            total_n
        )

    else:

        case_width = 0
        control_width = 0

    # --------------------------------------------------------------
    # DRAW CASE / SALMON PORTION
    #
    # Slight perpendicular offset makes both components visible.
    # --------------------------------------------------------------

    dx = x2 - x1
    dy = y2 - y1

    length = np.sqrt(
        dx**2 + dy**2
    )

    if length == 0:
        continue

    # Unit perpendicular vector
    px = -dy / length
    py = dx / length

    # Very small offset
    offset = 0.006

    # Salmon line
    ax.plot(
        [
            x1 + px * offset,
            x2 + px * offset
        ],
        [
            y1 + py * offset,
            y2 + py * offset
        ],
        color=CASE_COLOR,
        linewidth=max(
            case_width,
            0.8 if case_n > 0 else 0
        ),
        solid_capstyle="round",
        alpha=0.90,
        zorder=1
    )

    # Blue line
    ax.plot(
        [
            x1 - px * offset,
            x2 - px * offset
        ],
        [
            y1 - py * offset,
            y2 - py * offset
        ],
        color=CONTROL_COLOR,
        linewidth=max(
            control_width,
            0.8 if control_n > 0 else 0
        ),
        solid_capstyle="round",
        alpha=0.90,
        zorder=1
    )


# ======================================================================
# EDGE NUMBERS
#
# Reference says the number on the edge is proportional to the
# overlapped microbes.
#
# We display the actual TOTAL overlap number.
#
# Example:
#     41
#
# while the edge itself visually shows:
#     17 case + 24 control
# ======================================================================

for _, row in network.iterrows():

    disease_a = row["Disease_A"]
    disease_b = row["Disease_B"]

    case_n = row["Case_overlap"]
    control_n = row["Control_overlap"]
    total_n = row["Total_overlap"]

    x1, y1 = positions[
        disease_a
    ]

    x2, y2 = positions[
        disease_b
    ]

    # Midpoint
    mx = (
        x1 + x2
    ) / 2

    my = (
        y1 + y2
    ) / 2

    dx = x2 - x1
    dy = y2 - y1

    length = np.sqrt(
        dx**2 + dy**2
    )

    px = -dy / length
    py = dx / length

    # Place label slightly away from edge
    label_offset = 0.035

    lx = (
        mx
        +
        px * label_offset
    )

    ly = (
        my
        +
        py * label_offset
    )

    ax.text(
        lx,
        ly,
        str(total_n),
        fontsize=15,
        fontweight="bold",
        ha="center",
        va="center",
        zorder=5,
        bbox=dict(
            boxstyle="round,pad=0.16",
            facecolor="white",
            edgecolor="none",
            alpha=0.90
        )
    )


# ======================================================================
# DRAW DISEASE NODES
#
# Same node size for every disease.
#
# This is important:
# the reference does NOT use node size as weighted degree.
# ======================================================================

NODE_SIZE = 2500

for disease in diseases_order:

    x, y = positions[
        disease
    ]

    ax.scatter(
        x,
        y,
        s=NODE_SIZE,
        facecolor=NODE_FACE,
        edgecolor=NODE_EDGE,
        linewidth=2.2,
        zorder=4
    )


# ======================================================================
# DISEASE LABELS
# ======================================================================

for disease in diseases_order:

    x, y = positions[
        disease
    ]

    angle = np.arctan2(
        y,
        x
    )

    label_radius = 1.18

    lx = (
        label_radius
        *
        np.cos(angle)
    )

    ly = (
        label_radius
        *
        np.sin(angle)
    )

    display_name = (
        disease
        .replace(
            "_",
            " "
        )
    )

    ax.text(
        lx,
        ly,
        display_name,
        fontsize=22,
        fontweight="bold",
        ha="center",
        va="center",
        zorder=6
    )


# ======================================================================
# LEGEND
#
# Explicitly communicates the biological meaning of edge colors.
# ======================================================================

legend_handles = [

    Line2D(
        [0],
        [0],
        color=CASE_COLOR,
        linewidth=7,
        label="Case-associated overlap"
    ),

    Line2D(
        [0],
        [0],
        color=CONTROL_COLOR,
        linewidth=7,
        label="Control-associated overlap"
    )
]

legend = ax.legend(
    handles=legend_handles,
    loc="lower center",
    bbox_to_anchor=(0.5, -0.055),
    ncol=2,
    frameon=False,
    fontsize=18,
    handlelength=2.5
)


# ======================================================================
