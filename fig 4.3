angles = np.linspace(
    np.pi / 2,
    np.pi / 2 + 2 * np.pi,
    n,
    endpoint=False
)

# Radius
radius = 1.0

positions = {}

for disease, angle in zip(
    ordered_diseases,
    angles
):

    positions[disease] = (
        radius * np.cos(angle),
        radius * np.sin(angle)
    )


# ======================================================================
# NODE SIZE
#
# Larger weighted degree = larger node.
# ======================================================================

min_weight = min(
    weighted_degree.values()
)

max_weight = max(
    weighted_degree.values()
)

def node_size(weight):

    if max_weight == min_weight:

        return 2300

    return (
        1500
        +
        (
            (
                weight - min_weight
            )
            /
            (
                max_weight - min_weight
            )
        )
        * 2300
    )


# ======================================================================
# FIGURE
