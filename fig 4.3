# ======================================================================
# EDGE WIDTH
#
# Stronger disease similarity = thicker edge.
# ======================================================================

min_edge = network_edges[
    "Edge_Weight"
].min()

max_edge = network_edges[
    "Edge_Weight"
].max()


def edge_width(weight):

    if max_edge == min_edge:

        return 2.0

    return (
        1.0
        +
        (
            (
                weight - min_edge
            )
            /
            (
                max_edge - min_edge
            )
        )
        * 5.0
    )


# ======================================================================
# DRAW EDGES
