# ======================================================================
# NORMALIZE COLUMN IDENTIFICATION
# ======================================================================

def find_column(
    df,
    candidates
):

    normalized = {
        str(c).strip().lower().replace(" ", "_"): c
        for c in df.columns
    }

    for candidate in candidates:

        key = (
            candidate
            .strip()
            .lower()
            .replace(" ", "_")
        )

        if key in normalized:

            return normalized[key]

    return None


